                    },
                    "422": {
                        "description": "Validation error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApiObjectResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "data": {
                        "type": "object",
                        "nullable": true
                    },
                    "errors": {
                        "type": "object",
                        "example": null,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ApiCollectionResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    },
                    "errors": {
                        "type": "object",
                        "example": null,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ApiPaginatedResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    },
                    "errors": {
                        "type": "object",
                        "example": null,
                        "nullable": true
                    },
                    "meta": {
                        "properties": {
                            "current_page": {
                                "type": "integer",
                                "example": 1
                            },
                            "from": {
                                "type": "integer",
                                "example": 1,
                                "nullable": true
                            },
                            "last_page": {
                                "type": "integer",
                                "example": 5
                            },
                            "path": {
                                "type": "string",
                                "example": "https://example.com/api/v1/catalog/products"
                            },
                            "per_page": {
                                "type": "integer",
                                "example": 20
                            },
                            "to": {
                                "type": "integer",
                                "example": 20,
                                "nullable": true
                            },
                            "total": {
                                "type": "integer",
                                "example": 100
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ApiErrorResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "The given data was invalid."
                    },
                    "data": {
                        "type": "object",
                        "example": null,
                        "nullable": true
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "CartItemRequest": {
                "required": [
                    "product_id",
                    "quantity"
                ],
                "properties": {
                    "product_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "product_variant_id": {
                        "type": "integer",
                        "example": 5,
                        "nullable": true
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 2,
                        "minimum": 1
                    }
                },
                "type": "object"
            }
        },
        "parameters": {
            "AcceptJsonHeader": {
                "name": "Accept",
                "in": "header",
                "required": false,
                "schema": {
                    "type": "string",
                    "default": "application/json"
                },
                "example": "application/json"
            },
            "CartTokenHeader": {
                "name": "X-Cart-Token",
                "in": "header",
                "description": "Guest cart token. Authenticated customers may omit this header.",
                "required": false,
                "schema": {
                    "type": "string"
                },
                "example": "cart_01HZ..."
            },
            "SearchQuery": {
                "name": "search",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "string"
                },
                "example": "shirt"
            },
            "SortQuery": {
                "name": "sort",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "string",
                    "enum": [
                        "latest",
                        "oldest",
                        "price_asc",
                        "price_desc",
                        "name_asc",
                        "name_desc",
                        "popular"
                    ]
                },
                "example": "latest"
            }
        }
    },
    "tags": [
        {
            "name": "Catalog",
            "description": "Public catalog browsing endpoints."
        },
        {
            "name": "Cart",
            "description": "Guest and customer cart endpoints."
        },
        {
            "name": "Checkout",
            "description": "Checkout helper endpoints."
        }
    ]
}