        "/api/v1/checkout/shipping-methods/resolve": {
            "post": {
                "tags": [
                    "Checkout"
                ],
                "summary": "Resolve available shipping methods",
                "operationId": "resolveCheckoutShippingMethods",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptJsonHeader"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "state"
                                ],
                                "properties": {
                                    "country": {
                                        "type": "string",
                                        "example": "NG"
                                    },
                                    "state": {
                                        "type": "string",
                                        "example": "Lagos"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Ikeja"
                                    },
                                    "postal_code": {
                                        "type": "string",
                                        "example": "100001",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Shipping methods returned.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiObjectResponse"
                                }
                            }
