                    },
                    "422": {
                        "description": "Validation or cart error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cart/coupon": {
            "post": {
                "tags": [
