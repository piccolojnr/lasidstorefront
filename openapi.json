        "/api/v1/cart/items": {
            "post": {
                "tags": [
                    "Cart"
                ],
                "summary": "Add an item to the cart",
                "operationId": "storeCartItem",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptJsonHeader"
                    },
                    {
