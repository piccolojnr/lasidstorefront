                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cart/items/{cartItem}": {
            "delete": {
                "tags": [
                    "Cart"
                ],
                "summary": "Remove a cart item",
                "operationId": "deleteCartItem",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptJsonHeader"
                    },
                    {
                        "$ref": "#/components/parameters/CartTokenHeader"
                    },
                    {
                        "name": "cartItem",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 10
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cart item removed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiObjectResponse"
                                }
                            }
