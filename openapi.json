                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Cart"
                ],
                "summary": "Remove the cart coupon",
                "operationId": "removeCartCoupon",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AcceptJsonHeader"
                    },
                    {
                        "$ref": "#/components/parameters/CartTokenHeader"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Coupon removed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiObjectResponse"
                                }
                            }
                        }
                    }
                }
            }
