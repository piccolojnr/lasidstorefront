# ──────────────────────────────────────────────
# backthred/storefront — Docker Compose environment
# Copy to .env and fill in values before running:
# docker compose -f docker/compose.yaml up
# ──────────────────────────────────────────────

# Image coordinates
BACKTHRED_STOREFRONT_IMAGE=ghcr.io/piccolojnr/backthred/storefront
BACKTHRED_STOREFRONT_TAG=latest

# Which .env file to mount into the container at runtime (relative to compose.yaml)
BACKTHRED_STOREFRONT_COMPOSE_ENV_FILE=.env

# Port exposed on the host (127.0.0.1 only — put a reverse proxy in front)
APP_PORT=4321

# Server-side API base URL used by Astro SSR (not baked at build time)
# Must be reachable from inside the container.
API_BASE=https://api.backthred.com/api/v1

# ── These are baked into the JS bundle at build time (docker build --build-arg) ──
PUBLIC_API_BASE=https://api.backthred.com/api/v1
PUBLIC_SITE_URL=https://www.backthred.com
