---
import Layout from './layout.astro';
import { ROUTES } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;

const icons = {
  orders: '<path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />',
  addresses: '<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />',
  wishlist: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />',
  profile: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />',
} as const;

const nav = [
  { href: ROUTES.accountOrders, label: 'Orders', icon: icons.orders },
  { href: ROUTES.accountAddresses, label: 'Addresses', icon: icons.addresses },
  { href: ROUTES.accountWishlist, label: 'Wishlist', icon: icons.wishlist },
  { href: ROUTES.accountProfile, label: 'Profile', icon: icons.profile },
];

function isActive(href: string): boolean {
  if (href === ROUTES.accountProfile) return pathname === href;
  return pathname === href || pathname.startsWith(href + '/');
}
---

<Layout title={title}>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">

    <!-- Mobile: horizontal scrollable nav -->
    <nav
      aria-label="Account"
      class="-mx-4 mb-6 overflow-x-auto px-4 pb-1 [scrollbar-width:none] [-ms-overflow-style:none] lg:hidden [&::-webkit-scrollbar]:hidden"
    >
      <div class="flex min-w-max gap-2">
        {nav.map(({ href, label, icon }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full border px-3.5 py-2 text-sm font-medium transition-colors',
              isActive(href)
                ? 'border-foreground bg-foreground text-background'
                : 'border-border bg-background text-muted-foreground hover:border-foreground/30 hover:text-foreground',
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
              set:html={icon}
            />
            {label}
          </a>
        ))}
      </div>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10">

      <!-- Desktop: sidebar -->
      <aside class="hidden lg:block">
        <nav aria-label="Account" class="sticky top-24 flex flex-col gap-1">
          <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
            My account
          </p>
          {nav.map(({ href, label, icon }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors',
                isActive(href)
                  ? 'bg-muted text-foreground'
                  : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
              ]}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
                set:html={icon}
              />
              {label}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Content -->
      <div class="min-w-0">
        <div class="mb-7">
          <h1 class="font-heading text-xl font-bold tracking-tight text-foreground sm:text-2xl">{title}</h1>
          {description && (
            <p class="mt-1.5 text-sm text-muted-foreground">{description}</p>
          )}
        </div>
        <slot />
      </div>

    </div>
  </div>
</Layout>
