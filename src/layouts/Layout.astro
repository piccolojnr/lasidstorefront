---
import "../styles/global.css";
import AppBootstrap from "../components/auth/app-bootstrap";
import CartCount from "../components/cart/cart-count";
import { ROUTES } from "../lib/constants";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Lasid Storefront" } = Astro.props;
const pathname = Astro.url.pathname;

const navLinks = [{ href: ROUTES.products, label: "Shop" }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} — Lasid</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 antialiased">
    <!-- Bootstrap island: CSRF + session + cart (no UI) -->
    <AppBootstrap client:load />

    <header
      class="sticky top-0 z-40 border-b border-gray-100 bg-white/90 backdrop-blur"
    >
      <div
        class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6"
      >
        <!-- Logo -->
        <a href={ROUTES.home} class="text-xl font-bold tracking-tight">
          Lasid
        </a>

        <!-- Primary nav -->
        <nav
          class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600"
        >
          {
            navLinks.map(({ href, label }) => (
              <a
                href={href}
                class:list={[
                  "transition-colors hover:text-gray-900",
                  pathname.startsWith(href) && "text-gray-900",
                ]}
              >
                {label}
              </a>
            ))
          }
        </nav>

        <!-- Right actions -->
        <div class="flex items-center gap-4">
          <!-- Cart -->
          <a href={ROUTES.cart} class="relative p-1.5" aria-label="Cart">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
              ></path>
            </svg>
            <CartCount client:load />
          </a>

          <!-- Account -->
          <a href={ROUTES.accountOrders} class="p-1.5" aria-label="Account">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main class="grow">
      <slot />
    </main>

    <footer
      class="mt-24 border-t border-gray-100 py-10 text-center text-sm text-gray-400"
    >
      &copy; {new Date().getFullYear()} Lasid. All rights reserved.
    </footer>
  </body>
</html>
