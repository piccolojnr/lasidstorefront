---
import "../styles/global.css";
import AppBootstrap from "../components/auth/app-bootstrap";
import SiteHeader from "../components/site-header.astro";
import { ROUTES } from "../lib/constants";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Everyday goods for everyday Ghanaians." } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#D4521A" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — Lasid`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/primary-logo.png" />
    <title>{title} — Lasid</title>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <AppBootstrap client:load />

    <SiteHeader />

    <main class="grow">
      <slot />
    </main>

    <footer class="border-t border-border mt-24">
      <div
        class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4"
      >
        <a
          href={ROUTES.home}
          class="flex items-center gap-2 shrink-0 hover:opacity-80 transition-opacity"
          aria-label="Lasid — home"
        >
          <img
            src="/primary-logo.png"
            alt=""
            class="h-20 w-auto"
            aria-hidden="true"
          />
        </a>
        <p class="text-muted-foreground text-sm text-center">
          Everyday goods for everyday Ghanaians.
        </p>
        <p class="text-muted-foreground text-sm">
          &copy; {new Date().getFullYear()} Lasid
        </p>
      </div>
    </footer>
  </body>
</html>
