---
interface Props {
  value?: string;
}

const { value = 'latest' } = Astro.props;

const options = [
  { value: 'latest', label: 'Latest' },
  { value: 'price_asc', label: 'Price: Low to High' },
  { value: 'price_desc', label: 'Price: High to Low' },
];
---

<select
  name="sort"
  onchange="this.form && this.form.submit()"
  class="rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
>
  {options.map((opt) => (
    <option value={opt.value} selected={opt.value === value}>
      {opt.label}
    </option>
  ))}
</select>
