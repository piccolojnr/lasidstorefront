---
import CardAddToCartButton from "../cart/card-add-to-cart-button";
import WishlistButton from "./wishlist-button";
import { formatMoney } from "../../lib/money";
import type { ProductSummary, Badge } from "../../api/catalog";

interface Props {
  product: ProductSummary;
}

const { product } = Astro.props;

const cardImageSrc =
  product.primary_image_card_url ?? product.primary_image_url;
const sourceLabel = product.category?.name ?? product.brand?.name ?? null;

const hasCompareAtPrice =
  product.compare_at_price !== null &&
  product.compare_at_price > product.base_price;
const isOnSale =
  product.is_on_sale === true ||
  hasCompareAtPrice ||
  product.badges?.some((badge) => badge.key === "on_sale");
const discountPercentage =
  typeof product.discount_percentage === "number"
    ? Math.round(product.discount_percentage)
    : null;

const visibleBadges = (product.badges ?? [])
  .filter(
    (badge, index, arr) =>
      arr.findIndex((item) => item.key === badge.key) === index,
  )
  .slice(0, 2);

function badgeClasses(badge: Badge) {
  if (badge.key === "on_sale") {
    return "bg-destructive text-white";
  }

  return "bg-background/95 text-foreground";
}

const stock = product.stock ?? null;
const isOutOfStock =
  stock?.status === "out_of_stock" && !stock.is_backorderable;
const hasVariants = Array.isArray((product as any).variants) && (product as any).variants.length > 0;

let stockLabel: string | null = null;
let stockClasses = "text-muted-foreground";
let buttonLabel = "Add to Cart";

if (stock) {
  if (stock.status === "out_of_stock" && stock.is_backorderable) {
    stockLabel = "Pre-order available";
    stockClasses = "text-warning";
    buttonLabel = "Pre-order";
  } else if (stock.status === "out_of_stock") {
    stockLabel = "Out of stock";
    stockClasses = "text-destructive";
    buttonLabel = "Out of Stock";
  } else if (
    stock.status === "low_stock" ||
    (typeof stock.quantity === "number" &&
      stock.quantity > 0 &&
      stock.quantity <= 5)
  ) {
    stockLabel = "Only a few left";
    stockClasses = "text-warning";
  }
}
---

<div
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-border bg-background transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
>
  <!-- Wishlist button sits on top of the card, outside the anchor so clicks don't navigate -->
  <div class="absolute right-2 top-2 z-10">
    <WishlistButton productId={product.id} client:load />
  </div>

  <a
    href={`/products/${product.slug}`}
    class="relative block aspect-square overflow-hidden bg-muted"
    aria-label={`View ${product.name}`}
  >
    {
      cardImageSrc ? (
        <img
          src={cardImageSrc}
          alt={product.name}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-muted-foreground/40">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-12 w-12"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.25"
              d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
            />
          </svg>
        </div>
      )
    }

    {
      visibleBadges.length > 0 && (
        <div class="absolute left-2 top-2 flex flex-wrap gap-1">
          {visibleBadges.map((badge) => (
            <span
              class:list={[
                "rounded-full px-1.5 py-0.5 text-[10px] font-semibold leading-none shadow-sm sm:px-2 sm:py-1 sm:text-[11px]",
                badgeClasses(badge),
              ]}
            >
              {badge.key === "new_arrival" ? "New" : badge.label}
            </span>
          ))}
          {isOnSale && discountPercentage && (
            <span class="rounded-full bg-destructive px-1.5 py-0.5 text-[10px] font-semibold leading-none text-white shadow-sm sm:px-2 sm:py-1 sm:text-[11px]">
              -{discountPercentage}%
            </span>
          )}
        </div>
      )
    }

  </a>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    {
      sourceLabel && (
        <p class="hidden text-xs text-muted-foreground sm:block">
          {sourceLabel}
        </p>
      )
    }

    <a
      href={`/products/${product.slug}`}
      class="line-clamp-2 text-[13px] font-medium leading-5 text-foreground transition-colors hover:text-foreground/80 sm:mt-1 sm:text-sm"
    >
      {product.name}
    </a>

    <div class="mt-2 flex items-center justify-between gap-2 sm:mt-3 sm:block">
      <div class="flex min-w-0 flex-wrap items-baseline gap-x-1.5 gap-y-1">
        <span class="text-sm font-bold text-foreground sm:text-base">
          {formatMoney(product.base_price)}
        </span>
        {
          hasCompareAtPrice && (
            <span class="truncate text-xs text-muted-foreground line-through sm:text-sm">
              {formatMoney(product.compare_at_price!)}
            </span>
          )
        }
      </div>

      <div class="shrink-0 sm:hidden">
        <CardAddToCartButton
          client:load
          productId={product.id}
          productSlug={product.slug}
          hasVariants={hasVariants}
          disabled={isOutOfStock}
          label={buttonLabel}
        />
      </div>
    </div>

    {
      stockLabel && (
        <p class:list={["mt-1 text-xs font-medium", stockClasses]}>{stockLabel}</p>
      )
    }

    <div class="mt-2 hidden sm:block">
      <CardAddToCartButton
        client:load
        productId={product.id}
        productSlug={product.slug}
        hasVariants={hasVariants}
        disabled={isOutOfStock}
        label={buttonLabel}
      />
    </div>
  </div>
</div>
