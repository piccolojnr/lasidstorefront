---
import type { Category } from "../../api/catalog";

interface Props {
  category: Category;
  size?: "hero" | "medium" | "small";
  eager?: boolean;
}

const { category, size = "small", eager = false } = Astro.props;

const children = category.children ?? [];
const maxChips = size === "hero" ? 4 : size === "medium" ? 3 : 0;
const visibleChildren = children.slice(0, maxChips);
const extraCount = children.length - visibleChildren.length;
const hasImage = !!category.image_url;

const tileClasses = {
  hero: "col-span-2 min-h-56 rounded-2xl sm:min-h-80",
  medium: "min-h-44 rounded-2xl sm:min-h-80",
  small: "min-h-36 rounded-xl sm:min-h-44",
}[size];

const paddingClasses = {
  hero: "p-5 sm:p-7",
  medium: "p-4 sm:p-5",
  small: "p-3 sm:p-4",
}[size];

const nameClasses = {
  hero: "font-heading text-xl font-bold leading-tight sm:text-3xl",
  medium: "font-heading text-base font-bold leading-tight sm:text-xl",
  small: "font-heading text-sm font-bold leading-tight sm:text-base",
}[size];

const initialClasses = {
  hero: "text-[10rem] sm:text-[14rem]",
  medium: "text-[7rem] sm:text-[10rem]",
  small: "text-[5.5rem]",
}[size];

const textColor = hasImage ? "text-white" : "text-foreground";
const chipClasses = hasImage
  ? "bg-white/15 text-white/90 backdrop-blur-sm hover:bg-white/25"
  : "bg-foreground/5 text-foreground/70 hover:bg-foreground/10";
---

<div
  class:list={[
    "group relative overflow-hidden",
    tileClasses,
    hasImage
      ? "bg-foreground"
      : "bg-linear-to-br from-secondary via-accent/60 to-secondary",
  ]}
>
  {/* Background: image, or a large serif initial as a brand-tinted fallback */}
  {
    hasImage ? (
      <>
        <img
          src={category.image_url}
          alt=""
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          loading={eager ? "eager" : "lazy"}
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/25 to-transparent" />
      </>
    ) : (
      <span
        aria-hidden="true"
        class:list={[
          "absolute inset-0 flex select-none items-center justify-center font-heading font-bold leading-none text-foreground/8",
          initialClasses,
        ]}
      >
        {category.name.charAt(0)}
      </span>
    )
  }

  {/* Content — the name link stretches to cover the whole tile */}
  <div class:list={["relative flex h-full flex-col justify-end", paddingClasses]}>
    {
      size === "hero" && (
        <span
          class:list={[
            "absolute left-5 top-5 inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest sm:left-7 sm:top-7",
            hasImage
              ? "bg-white/15 text-white/90 backdrop-blur-sm"
              : "bg-foreground/5 text-foreground/70",
          ]}
        >
          Featured
        </span>
      )
    }

    <h2 class:list={[nameClasses, textColor]}>
      <a
        href={`/products?category=${category.slug}`}
        class="transition-colors after:absolute after:inset-0 after:content-['']"
      >
        {category.name}
      </a>
    </h2>

    {
      /* Subcategory quick links — sit above the stretched link */
      visibleChildren.length > 0 && (
        <div class="relative z-10 mt-2.5 flex flex-wrap gap-1.5">
          {visibleChildren.map((child) => (
            <a
              href={`/products?category=${child.slug}`}
              class:list={[
                "rounded-full px-2.5 py-1 text-xs font-medium transition-colors",
                chipClasses,
              ]}
            >
              {child.name}
            </a>
          ))}
          {extraCount > 0 && (
            <span
              class:list={[
                "rounded-full px-2.5 py-1 text-xs font-medium",
                hasImage ? "text-white/60" : "text-muted-foreground",
              ]}
            >
              +{extraCount} more
            </span>
          )}
        </div>
      )
    }

    {
      size === "hero" && (
        <span
          class:list={[
            "mt-3.5 inline-flex w-fit items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold transition-colors",
            hasImage
              ? "bg-white/20 text-white backdrop-blur-sm group-hover:bg-white/30"
              : "bg-foreground text-background group-hover:bg-foreground/85",
          ]}
        >
          Shop now
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m8.25 4.5 7.5 7.5-7.5 7.5"
            />
          </svg>
        </span>
      )
    }
  </div>
</div>
