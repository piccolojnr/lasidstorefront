---
import CartCount from "./cart/cart-count";
import HeaderSearch from "./header-search";
import { catalogApi, type Category } from "../api/catalog";
import { ROUTES } from "../lib/constants";

const pathname = Astro.url.pathname;
const searchValue = Astro.url.searchParams.get("search") ?? "";
const activeCategory = Astro.url.searchParams.get("category") ?? "";
const categoriesResult = await catalogApi
  .getCategories({ root_only: true })
  .catch(() => []);

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

function flattenCategories(
  items: Category[],
  depth = 0,
): Array<{
  label: string;
  slug: string;
}> {
  return items.flatMap((item) => [
    {
      slug: item.slug,
      label: `${depth > 0 ? `${"  ".repeat(depth)} ` : ""}${item.name}`,
    },
    ...flattenCategories(item.children ?? [], depth + 1),
  ]);
}

const categoryOptions = flattenCategories(categoriesResult);

const mobileLinks = [
  { href: ROUTES.products, label: "Shop" },
  { href: ROUTES.collections, label: "Collections" },
  { href: ROUTES.accountOrders, label: "Account" },
];
---

<div id="site-header-wrap" class="sticky top-0 z-40 bg-background">
  <header class="border-b border-border bg-background/95 backdrop-blur-sm">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:px-6 lg:px-8"
    >
      <div class="flex items-center justify-between gap-3 md:hidden">
        <div class="flex min-w-0 items-center gap-3">
          <a
            href={ROUTES.home}
            class="shrink-0 transition-opacity duration-150 hover:opacity-85"
            aria-label="Lasid home"
          >
            <img
              src="/primary-logo.png"
              alt=""
              class="h-12 w-auto"
              aria-hidden="true"
            />
          </a>
        </div>

        <div class="flex items-center gap-1">
          <a
            href={ROUTES.cart}
            class:list={[
              "relative rounded-lg p-2 text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground",
              isActive(ROUTES.cart) && "bg-accent text-accent-foreground",
            ]}
            aria-label="Open cart"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
              ></path>
            </svg>
            <CartCount client:load />
          </a>

          <button
            id="menu-toggle"
            type="button"
            class="rounded-lg p-2 text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <svg
              id="icon-open"
              xmlns="http://www.w3.org/2000/svg"
              class="size-4.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
            </svg>
            <svg
              id="icon-close"
              xmlns="http://www.w3.org/2000/svg"
              class="hidden size-4.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="md:hidden">
        <HeaderSearch
          action={ROUTES.products}
          categories={categoryOptions}
          defaultCategory={activeCategory}
          defaultSearch={searchValue}
          mode="mobile"
          client:load
        />
      </div>

      <div
        class="hidden md:grid md:grid-cols-[auto_minmax(0,1fr)_auto_auto] md:items-center md:gap-5"
      >
        <a
          href={ROUTES.home}
          class="shrink-0 transition-opacity duration-150 hover:opacity-85"
          aria-label="Lasid home"
        >
          <img
            src="/primary-logo.png"
            alt=""
            class="h-14 w-auto"
            aria-hidden="true"
          />
        </a>

        <HeaderSearch
          action={ROUTES.products}
          categories={categoryOptions}
          defaultCategory={activeCategory}
          defaultSearch={searchValue}
          mode="desktop"
          client:load
        />

        <a
          href={ROUTES.cart}
          class:list={[
            "relative rounded-lg p-2 text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground",
            isActive(ROUTES.cart) && "bg-accent text-accent-foreground",
          ]}
          aria-label="Open cart"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-[18px]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
            ></path>
          </svg>
          <CartCount client:load />
        </a>

        <a
          href={ROUTES.accountOrders}
          class:list={[
            "rounded-lg border px-4 py-2 text-sm font-medium transition-colors duration-150",
            isActive("/account")
              ? "border-primary bg-primary text-primary-foreground"
              : "border-border text-foreground hover:bg-muted",
          ]}
        >
          Account
        </a>
      </div>

      <div
        id="mobile-nav"
        class="hidden border-t border-border pt-3 md:hidden"
        aria-label="Mobile navigation"
      >
        <nav class="flex flex-col gap-1" aria-label="Mobile menu links">
          {
            mobileLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "rounded-lg px-3 py-2.5 text-sm font-medium transition-colors duration-150",
                  isActive(link.href)
                    ? "bg-accent text-accent-foreground"
                    : "text-muted-foreground hover:bg-muted hover:text-foreground",
                ]}
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={ROUTES.authLogin}
            class="mt-2 rounded-lg bg-primary px-3 py-2.5 text-center text-sm font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/90"
          >
            Sign in
          </a>
        </nav>
      </div>
    </div>
  </header>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = !nav?.classList.contains("hidden");
    nav?.classList.toggle("hidden", isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    toggle.setAttribute(
      "aria-label",
      isOpen ? "Open navigation menu" : "Close navigation menu",
    );
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-label", "Open navigation menu");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
