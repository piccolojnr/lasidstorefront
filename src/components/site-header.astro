---
import CartCount from "./cart/cart-count";
import HeaderSearch from "./header-search";
import { catalogApi, type Category } from "../api/catalog";
import { ROUTES } from "../lib/constants";
import { siteConfig } from "../lib/site-config";

const pathname = Astro.url.pathname;
const searchValue = Astro.url.searchParams.get("search") ?? "";
const activeCategory = Astro.url.searchParams.get("category") ?? "";
const activeSort = Astro.url.searchParams.get("sort") ?? "";
const isOnSale = Astro.url.searchParams.get("on_sale") === "true";

const categoriesResult = await catalogApi
  .getCategories({ root_only: true })
  .catch(() => []);

function flattenCategories(
  items: Category[],
  depth = 0,
): Array<{
  label: string;
  slug: string;
}> {
  return items.flatMap((item) => [
    {
      slug: item.slug,
      label: `${depth > 0 ? `${"— ".repeat(depth)}` : ""}${item.name}`,
    },
    ...flattenCategories(item.children ?? [], depth + 1),
  ]);
}

const categoryOptions = flattenCategories(categoriesResult);

const activeNavKey =
  pathname !== ROUTES.products
    ? null
    : isOnSale
      ? "flash-sales"
      : activeSort === "latest"
        ? "new-arrivals"
        : activeCategory
          ? `category:${activeCategory}`
          : "all";

const primaryNavLinks = [
  {
    key: "all",
    href: ROUTES.products,
    label: "All",
  },
  {
    key: "new-arrivals",
    href: "/products?sort=latest",
    label: "New Arrivals",
  },
  ...categoriesResult.slice(0, 6).map((category) => ({
    key: `category:${category.slug}`,
    href: `/products?category=${category.slug}`,
    label: category.name,
  })),
  {
    key: "flash-sales",
    href: "/products?on_sale=true",
    label: "Flash Sales",
  },
];

const mobileLinks = [
  {
    href: ROUTES.products,
    label: "Shop all",
  },
  {
    href: "/products?sort=latest",
    label: "New Arrivals",
  },
  {
    href: "/products?on_sale=true",
    label: "Flash Sales",
  },
  {
    href: ROUTES.collections,
    label: "Collections",
  },
  {
    href: ROUTES.accountOrders,
    label: "Account",
  },
];

const isRouteActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<div id="site-header-wrap" class="sticky top-0 z-40 bg-background">
  <header class="bg-background/95 backdrop-blur-md border">
    <div class="mx-auto max-w-360 px-4 sm:px-6 lg:px-8">
      <!-- Mobile main row -->
      <div class="flex h-14 items-center justify-between md:hidden">
        <a
          href={ROUTES.home}
          class="shrink-0 transition-opacity hover:opacity-80 font-black text-2xl"
          aria-label="Backthred home"
        >
          Backthred
        </a>

        <div class="flex items-center gap-0.5">
          <a
            href={ROUTES.accountOrders}
            class:list={[
              "flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground",
              isRouteActive(ROUTES.accountOrders) && "text-foreground",
            ]}
            aria-label="Open account"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-[18px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a8.25 8.25 0 0 1 15 0"
              ></path>
            </svg>
          </a>

          <a
            href={ROUTES.cart}
            class:list={[
              "flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground",
              isRouteActive(ROUTES.cart) && "text-foreground",
            ]}
            aria-label="Open cart"
          >
            <span class="relative">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-[18px]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
                ></path>
              </svg>

              <CartCount client:load />
            </span>
          </a>

          <button
            id="menu-toggle"
            type="button"
            class="flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <svg
              id="icon-open"
              xmlns="http://www.w3.org/2000/svg"
              class="size-[19px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>

            <svg
              id="icon-close"
              xmlns="http://www.w3.org/2000/svg"
              class="hidden size-[19px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile search -->
      <div class="pb-3 md:hidden">
        <HeaderSearch
          action={ROUTES.products}
          categories={categoryOptions}
          defaultCategory={activeCategory}
          defaultSearch={searchValue}
          mode="mobile"
          placeholder={siteConfig.header.searchPlaceholder}
          client:load
        />
      </div>

      <!-- Desktop main row -->
      <div
        class="hidden min-h-[58px] items-center gap-6 md:grid md:grid-cols-[auto_minmax(0,1fr)_auto]"
      >
        <a
          href={ROUTES.home}
          class="shrink-0 transition-opacity hover:opacity-80 font-black text-2xl"
          aria-label="Backthred home"
        >
          Backthred
        </a>

        <HeaderSearch
          action={ROUTES.products}
          categories={categoryOptions}
          defaultCategory={activeCategory}
          defaultSearch={searchValue}
          mode="desktop"
          placeholder={siteConfig.header.searchPlaceholder}
          client:load
        />

        <div class="flex items-center gap-1">
          <a
            href={ROUTES.accountOrders}
            class:list={[
              "group flex min-w-12 flex-col items-center justify-center px-1.5 py-1 text-[10px] leading-none text-muted-foreground transition-colors hover:text-foreground",
              isRouteActive(ROUTES.accountOrders) && "text-foreground",
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mb-1 size-[17px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.65"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a8.25 8.25 0 0 1 15 0"
              ></path>
            </svg>

            <span>Account</span>
          </a>

          <a
            href={ROUTES.products}
            class="group flex min-w-12 flex-col items-center justify-center px-1.5 py-1 text-[10px] leading-none text-muted-foreground transition-colors hover:text-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mb-1 size-[17px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.65"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
              ></path>
            </svg>

            <span>Wishlist</span>
          </a>

          <a
            href={ROUTES.cart}
            class:list={[
              "group flex min-w-12 flex-col items-center justify-center px-1.5 py-1 text-[10px] leading-none text-muted-foreground transition-colors hover:text-foreground",
              isRouteActive(ROUTES.cart) && "text-foreground",
            ]}
          >
            <span class="relative mb-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-[17px]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.65"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272"
                ></path>
              </svg>

              <CartCount client:load />
            </span>

            <span>Cart</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Top bar -->
    <div class="border-t border-border bg-primary text-primary-foreground">
      <div
        class="mx-auto flex min-h-6 max-w-360 items-center justify-center px-4 py-1 text-[10px] sm:justify-between sm:px-6 lg:px-8"
      >
        <p class="truncate">
          {siteConfig.topBar.message}
        </p>

        <div class="hidden items-center gap-5 md:flex">
          <span>{siteConfig.topBar.payment}</span>
          <span>{siteConfig.topBar.support}</span>
        </div>
      </div>
    </div>

    <!-- Desktop category navigation -->
    <div class="hidden border-t border-border md:block">
      <div
        class="mx-auto flex h-10 max-w-360 items-center justify-between gap-5 px-4 sm:px-6 lg:px-8"
      >
        <nav
          class="flex h-full min-w-0 items-center gap-5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          aria-label="Primary navigation"
        >
          {
            primaryNavLinks.map((link) => {
              const isActive = activeNavKey === link.key;

              return (
                <a
                  href={link.href}
                  class:list={[
                    "relative flex h-full shrink-0 items-center border-b-2 px-0.5 text-[12px] transition-colors",
                    isActive
                      ? "border-primary font-medium text-foreground"
                      : "border-transparent text-muted-foreground hover:text-foreground",
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>

        <div class="flex shrink-0 items-center gap-5 text-[11px]">
          <a
            href={siteConfig.contact.whatsappHref}
            class="flex items-center gap-1.5 font-medium text-success transition-opacity hover:opacity-75"
            target="_blank"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12.04 2a9.84 9.84 0 0 0-8.47 14.84L2 22l5.3-1.5A9.96 9.96 0 1 0 12.04 2Zm0 17.9a7.9 7.9 0 0 1-4.03-1.1l-.29-.17-3.14.88.84-3.06-.19-.31a7.86 7.86 0 1 1 6.81 3.76Zm4.32-5.89c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1-.37-1.91-1.18-.71-.63-1.19-1.4-1.33-1.64-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.4-.57 1.6-1.13.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
              ></path>
            </svg>

            <span>WhatsApp</span>
          </a>

          <a
            href={siteConfig.header.trackOrderHref}
            class="flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 21s6-4.35 6-11A6 6 0 0 0 6 10c0 6.65 6 11 6 11Z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 12.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z"
              ></path>
            </svg>

            <span>Track Order</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile navigation -->
    <div
      id="mobile-nav"
      class="hidden border-t border-border px-4 pb-4 pt-3 md:hidden"
      aria-label="Mobile navigation"
    >
      <nav class="grid grid-cols-2 gap-1" aria-label="Mobile menu links">
        {
          mobileLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "rounded-lg px-3 py-2.5 text-sm transition-colors",
                isRouteActive(link.href)
                  ? "bg-muted font-medium text-foreground"
                  : "text-muted-foreground hover:bg-muted hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          ))
        }

        <a
          href={siteConfig.contact.whatsappHref}
          class="col-span-2 rounded-lg px-3 py-2.5 text-sm font-medium text-success hover:bg-muted"
          target="_blank"
        >
          WhatsApp
        </a>

        <a
          href={siteConfig.header.trackOrderHref}
          class="col-span-2 rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted hover:text-foreground"
        >
          Track Order
        </a>
      </nav>
    </div>
  </header>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  const setMenuOpen = (open: boolean) => {
    nav?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);

    toggle?.setAttribute(
      "aria-label",
      open ? "Close navigation menu" : "Open navigation menu",
    );

    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => {
    const shouldOpen = nav?.classList.contains("hidden") ?? false;
    setMenuOpen(shouldOpen);
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      setMenuOpen(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenuOpen(false);
    }
  });

  //
  //
  //
  const updateSiteHeaderHeight = () => {
    const header = document.getElementById("site-header-wrap");

    if (!header) return;

    document.documentElement.style.setProperty(
      "--site-header-height",
      `${header.offsetHeight}px`,
    );
  };

  const siteHeader = document.getElementById("site-header-wrap");

  if (siteHeader) {
    updateSiteHeaderHeight();

    const headerResizeObserver = new ResizeObserver(updateSiteHeaderHeight);

    headerResizeObserver.observe(siteHeader);
  }

  window.addEventListener("resize", updateSiteHeaderHeight);
</script>
