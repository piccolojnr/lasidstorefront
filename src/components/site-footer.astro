---
import { ROUTES } from "../lib/constants";
import { siteConfig } from "../lib/site-config";
---

<footer class="mt-16 bg-secondary-foreground text-white">
  <div class="border-b border-white/10 bg-background">
    <div
      class="mx-auto grid max-w-360 gap-4 px-4 py-5 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8"
    >
      <div class="flex items-center gap-3">
        <span
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125"
            ></path>
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-foreground">Next-Day Delivery</p>
          <p class="text-xs text-muted-foreground">
            Available in Accra, Kumasi & Tema
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 8.25h19.5M3.75 6h16.5A1.5 1.5 0 0 1 21.75 7.5v9a1.5 1.5 0 0 1-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 3.75 6Z"
            ></path>
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-foreground">Pay with MoMo</p>
          <p class="text-xs text-muted-foreground">
            MTN, Telecel & AirtelTigo accepted
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M21.015 4.356v4.992m0 0h-4.992m4.992 0-3.181-3.183a8.25 8.25 0 0 0-13.803 3.7"
            ></path>
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-foreground">7-Day Returns</p>
          <p class="text-xs text-muted-foreground">
            Return or exchange within 7 days
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span
          class="flex size-9 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M18 10.5a6 6 0 1 0-12 0v.75a2.25 2.25 0 0 0-2.25 2.25v1.5A2.25 2.25 0 0 0 6 17.25h1.5V10.5a4.5 4.5 0 1 1 9 0v6.75H18A2.25 2.25 0 0 0 20.25 15v-1.5A2.25 2.25 0 0 0 18 11.25v-.75Z"
            ></path>
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-foreground">Customer Support</p>
          <p class="text-xs text-muted-foreground">
            {siteConfig.contact.supportHours}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-360 px-4 py-12 sm:px-6 lg:px-8">
    <div
      class="grid gap-10 md:grid-cols-[minmax(0,1.3fr)_repeat(4,minmax(0,1fr))]"
    >
      <div class="max-w-sm">
        <a
          href={ROUTES.home}
          class="inline-flex items-center transition-opacity hover:opacity-85 font-black text-2xl"
          aria-label="Backthred home"
        >
          Backthred
        </a>
        <p class="mt-4 text-sm leading-6 text-white/65">
          {siteConfig.footer.description}
        </p>
        <div class="mt-5 flex items-center gap-2">
          <a
            href="#"
            class="flex size-8 items-center justify-center rounded-full bg-white/10 text-white/70 transition-colors hover:bg-white/15 hover:text-white"
            aria-label="Instagram"
          >
            <span class="text-xs font-semibold">IG</span>
          </a>
          <a
            href="#"
            class="flex size-8 items-center justify-center rounded-full bg-white/10 text-white/70 transition-colors hover:bg-white/15 hover:text-white"
            aria-label="Facebook"
          >
            <span class="text-xs font-semibold">FB</span>
          </a>
          <a
            href="#"
            class="flex size-8 items-center justify-center rounded-full bg-white/10 text-white/70 transition-colors hover:bg-white/15 hover:text-white"
            aria-label="TikTok"
          >
            <span class="text-xs font-semibold">TT</span>
          </a>
        </div>
      </div>

      <div>
        <h2
          class="text-xs font-semibold uppercase tracking-widest text-white/45"
        >
          Shop
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            siteConfig.footer.shopLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/65 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="text-xs font-semibold uppercase tracking-widest text-white/45"
        >
          Customer Care
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            siteConfig.footer.careLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/65 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="text-xs font-semibold uppercase tracking-widest text-white/45"
        >
          Legal
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            siteConfig.footer.legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/65 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="text-xs font-semibold uppercase tracking-widest text-white/45"
        >
          Contact
        </h2>
        <div class="mt-4 flex flex-col gap-3 text-sm text-white/65">
          <p>{siteConfig.contact.location}</p>
          <a
            href={`tel:${siteConfig.contact.phone}`}
            class="transition-colors hover:text-white"
          >
            {siteConfig.contact.phone}
          </a>
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="transition-colors hover:text-white"
          >
            {siteConfig.contact.email}
          </a>
          <a
            href={siteConfig.contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-flex w-fit items-center rounded-lg bg-success px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-success/90"
          >
            {siteConfig.contact.whatsappLabel}
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-5 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; {new Date().getFullYear()} Backthred Ghana. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a href={ROUTES.privacyPolicy} class="hover:text-white"
          >Privacy Policy</a
        >
        <a href={ROUTES.termsOfService} class="hover:text-white"
          >Terms of Service</a
        >
      </div>
    </div>
  </div>
</footer>
