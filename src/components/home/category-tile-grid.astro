---
import type { Category } from "../../api/catalog";

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;

const fallbackImages = [
  "/images/hero-1.jpg",
  "/images/hero-2.jpg",
  "/images/hero-3.jpg",
  "/images/hero-4.jpg",
  "/images/hero-5.jpg",
];

const visibleCategories = categories.slice(0, 5);
---

{
  visibleCategories.length > 0 && (
    <section class="bg-background py-8 sm:py-10">
      <div class="mx-auto max-w-360 px-4 sm:px-6 lg:px-8">
        <div class="mb-5 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-heading text-2xl font-bold text-foreground">
              Browse Categories
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Find what you need, updated with fresh stock regularly.
            </p>
          </div>
          <a
            href="/products"
            class="shrink-0 text-sm font-semibold text-primary hover:text-primary/80"
          >
            See All
          </a>
        </div>

        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
          {visibleCategories.map((category, index) => {
            const isFeature = index === 0;
            const imageSrc =
              category.image_url ??
              fallbackImages[index % fallbackImages.length];

            return (
              <a
                href={`/products?category=${category.slug}`}
                class:list={[
                  "group relative min-h-34 overflow-hidden rounded-xl bg-foreground",
                  isFeature &&
                    "md:col-span-1 lg:col-span-2 lg:row-span-2 lg:min-h-60",
                ]}
              >
                <img
                  src={imageSrc}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                  aria-hidden="true"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent" />
                <div class="relative flex h-full flex-col justify-end p-4 sm:p-5">
                  <h3
                    class:list={[
                      "font-bold text-white",
                      isFeature ? "text-lg" : "text-sm",
                    ]}
                  >
                    {category.name}
                  </h3>
                  <p class="mt-0.5 text-xs text-white/70">Fresh stock & more</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )
}
