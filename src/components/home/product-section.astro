---
import ProductCard from "../catalog/product-card.astro";
import type { ProductSummary } from "../../api/catalog";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  products?: ProductSummary[] | null;
  viewAllHref?: string;
}

const {
  title,
  eyebrow,
  description,
  products = null,
  viewAllHref,
} = Astro.props;

const isLoading = products === null;
const hasProducts = Array.isArray(products) && products.length > 0;
const isEmpty = Array.isArray(products) && products.length === 0;
---

<section class="bg-background py-8 sm:py-10">
  <div class="mx-auto max-w-360 px-4 sm:px-6 lg:px-8">
    <div class="mb-4 flex items-start justify-between gap-3 sm:mb-5 sm:items-end sm:gap-4">
      <div class="min-w-0 max-w-2xl">
        {
          eyebrow && (
            <p class="text-xs font-semibold uppercase tracking-widest text-primary">
              {eyebrow}
            </p>
          )
        }
        <h2
          class:list={[
            "font-heading text-xl font-bold text-foreground sm:text-2xl lg:text-3xl",
            eyebrow && "mt-1.5",
          ]}
        >
          {title}
        </h2>
        {
          description && (
            <p class="mt-1 text-xs leading-5 text-muted-foreground sm:mt-2 sm:text-sm sm:leading-6">
              {description}
            </p>
          )
        }
      </div>
      {
        viewAllHref && (
          <a
            href={viewAllHref}
            class="group mt-1 shrink-0 inline-flex items-center gap-1 text-xs font-semibold text-primary transition-colors hover:text-primary/80 sm:mt-0 sm:gap-1.5 sm:text-sm sm:font-medium sm:text-muted-foreground sm:hover:text-foreground"
          >
            <span class="sm:hidden">All</span>
            <span class="hidden sm:inline">View All</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 sm:h-4 sm:w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        )
      }
    </div>

    {
      isLoading ? (
        <div class="grid grid-cols-2 gap-3 md:gap-4 lg:grid-cols-4">
          {Array.from({ length: 4 }).map(() => (
            <div class="overflow-hidden rounded-xl border border-border bg-background">
              <div class="aspect-square animate-pulse bg-muted" />
              <div class="space-y-3 p-4">
                <div class="h-3 w-16 animate-pulse rounded bg-muted" />
                <div class="h-4 w-full animate-pulse rounded bg-muted" />
                <div class="h-4 w-3/4 animate-pulse rounded bg-muted" />
                <div class="h-4 w-24 animate-pulse rounded bg-muted" />
                <div class="h-9 w-full animate-pulse rounded-lg bg-muted" />
              </div>
            </div>
          ))}
        </div>
      ) : hasProducts ? (
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : isEmpty ? (
        <div class="py-12 text-center">
          <p class="text-sm text-muted-foreground">No products available</p>
        </div>
      ) : null
    }
  </div>
</section>
