---
import CollectionPreviewCard from "./collection-preview-card.astro";
import type { CollectionDetail } from "../../api/catalog";

interface Props {
  details?: CollectionDetail[];
  title?: string;
}

const {
  details = [],
  title = "Featured Collections",
} = Astro.props;

const featuredDetail = details[0];
const gridDetails = details.slice(1, 5);
---

{
  details.length > 0 && (
    <section class="bg-background py-14 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {/* Section header */}
        <div class="mb-10 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-primary">
              Curated for you
            </p>
            <h2 class="mt-1.5 font-heading text-2xl font-bold text-foreground sm:text-3xl">
              {title}
            </h2>
          </div>
          <a
            href="/collections"
            class="group shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            View All
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        {/* Mobile: horizontal scroll */}
        <div class="overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] lg:hidden">
          <div class="flex min-w-max gap-4">
            {details.map((detail) => (
              <div class="w-[18rem] shrink-0">
                <CollectionPreviewCard detail={detail} />
              </div>
            ))}
          </div>
        </div>

        {/* Desktop: featured + grid layout */}
        <div class="hidden lg:grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-5">
          <div>
            {featuredDetail && (
              <CollectionPreviewCard detail={featuredDetail} featured />
            )}
          </div>
          <div class="grid grid-cols-2 gap-5">
            {gridDetails.map((detail) => (
              <CollectionPreviewCard detail={detail} />
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  div::-webkit-scrollbar {
    display: none;
  }
</style>
