---
const benefits = [
  {
    title: "Fast Delivery",
    text: "Delivery available across Ghana.",
    icon: "delivery",
  },
  {
    title: "Secure Payments",
    text: "Pay safely with trusted payment options.",
    icon: "lock",
  },
  {
    title: "Quality Products",
    text: "Products are sourced with care.",
    icon: "check",
  },
  {
    title: "Easy Support",
    text: "Get help when you need it.",
    icon: "support",
  },
];
---

<section class="bg-muted/40 py-12 lg:py-16">
  <div class="mx-auto max-w-360 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((benefit) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <div class="mb-3 flex size-11 items-center justify-center rounded-lg bg-primary/10 text-primary">
              {benefit.icon === "delivery" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                  />
                </svg>
              )}
              {benefit.icon === "lock" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                  />
                </svg>
              )}
              {benefit.icon === "check" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  />
                </svg>
              )}
              {benefit.icon === "support" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M18 10.5a6 6 0 1 0-12 0v.75a2.25 2.25 0 0 0-2.25 2.25v1.5A2.25 2.25 0 0 0 6 17.25h1.5V10.5a4.5 4.5 0 1 1 9 0v6.75H18A2.25 2.25 0 0 0 20.25 15v-1.5A2.25 2.25 0 0 0 18 11.25v-.75Z"
                  />
                </svg>
              )}
            </div>
            <h2 class="text-base font-semibold text-foreground">
              {benefit.title}
            </h2>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">
              {benefit.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
