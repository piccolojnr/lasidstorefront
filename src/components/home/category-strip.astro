---
interface CategoryItem {
  name: string;
  href: string;
  imageSrc?: string | null;
}

interface Props {
  categories?: CategoryItem[];
  viewAllHref?: string;
  maxVisible?: number;
}

const fallbackCategories: CategoryItem[] = [
  { name: "Clothing", href: "/products?category=clothing" },
  { name: "Shoes", href: "/products?category=shoes" },
  { name: "Bags", href: "/products?category=bags" },
  { name: "Electronics", href: "/products?category=electronics" },
  { name: "Kitchen", href: "/products?category=kitchen" },
  { name: "Books", href: "/products?category=books" },
];

const {
  categories = [],
  viewAllHref = "/products",
  maxVisible = 7,
} = Astro.props;

const sourceItems = categories.length > 0 ? categories : fallbackCategories;
const visibleItems = sourceItems.slice(0, maxVisible);
---

<div class="overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none]">
  <div class="flex min-w-max items-start gap-5 md:justify-center">
    {visibleItems.map((category) => (
      <a
        href={category.href}
        class="group flex w-24 shrink-0 snap-start flex-col items-center text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30"
      >
        <div class="flex size-14 items-center justify-center rounded-full border border-border bg-card text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
          {
            category.imageSrc ? (
              <img
                src={category.imageSrc}
                alt=""
                class="size-8 object-contain"
                loading="lazy"
                aria-hidden="true"
              />
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75A2.25 2.25 0 0 1 6 4.5h12a2.25 2.25 0 0 1 2.25 2.25v10.5A2.25 2.25 0 0 1 18 19.5H6a2.25 2.25 0 0 1-2.25-2.25V6.75Z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 9.75h7.5M8.25 14.25h7.5"
                />
              </svg>
            )
          }
        </div>
        <span class="mt-2 line-clamp-2 text-xs font-medium leading-4 text-foreground">
          {category.name}
        </span>
      </a>
    ))}

    <a
      href={viewAllHref}
      class="group flex w-24 shrink-0 snap-start flex-col items-center text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30"
    >
      <div class="flex size-14 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 6.75h3.75v3.75H6.75V6.75Zm6.75 0h3.75v3.75H13.5V6.75Zm-6.75 6.75h3.75v3.75H6.75V13.5Zm6.75 0h3.75v3.75H13.5V13.5Z"
          />
        </svg>
      </div>
      <span class="mt-2 line-clamp-2 text-xs font-medium leading-4 text-foreground">
        View All
      </span>
    </a>
  </div>
</div>

<style>
  div::-webkit-scrollbar {
    display: none;
  }
</style>
