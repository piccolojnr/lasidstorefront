---
import HeroCarousel from "./hero-carousel";
import CategoryStrip from "./category-strip.astro";

interface Slide {
  title: string;
  description: string;
  ctaHref: string;
  ctaLabel: string;
  imageSrc?: string | null;
  imageAlt: string;
  eyebrow?: string;
}

interface CategoryItem {
  name: string;
  href: string;
}

interface Props {
  slides: Slide[];
  categories: CategoryItem[];
}

const { slides, categories } = Astro.props;
---

<section class="border-b border-border bg-background">
  <div class="mx-auto">
    <HeroCarousel slides={slides} client:load />

    {
      categories.length > 0 && (
        <div class="mx-auto mt-6 max-w-7xl pb-6">
          <CategoryStrip categories={categories} viewAllHref="/products" />
        </div>
      )
    }
  </div>
</section>
