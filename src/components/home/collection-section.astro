---
import ProductCard from "../catalog/product-card.astro";
import type { CollectionDetail } from "../../api/catalog";

interface Props {
  detail: CollectionDetail;
}

const { detail } = Astro.props;
const { collection, products } = detail;
const visibleProducts = products.slice(0, 4);
---

<section class="py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="font-heading text-2xl font-bold text-foreground sm:text-3xl">
          {collection.name}
        </h2>
        {
          collection.description && (
            <p class="mt-2 text-sm leading-6 text-muted-foreground sm:text-base">
              {collection.description}
            </p>
          )
        }
      </div>
      <a
        href={`/collections/${collection.slug}`}
        class="shrink-0 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        View All →
      </a>
    </div>

    {
      visibleProducts.length > 0 ? (
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-2 md:grid-cols-3 md:gap-4 lg:grid-cols-4">
          {visibleProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-border bg-card px-6 py-12 text-center">
          <p class="text-sm text-muted-foreground">No products in this collection yet.</p>
        </div>
      )
    }
  </div>
</section>
