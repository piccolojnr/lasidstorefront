---
import ProductSection from "./product-section.astro";
import type { CollectionDetail } from "../../api/catalog";

interface Props {
  detail: CollectionDetail;
}

const { detail } = Astro.props;
const { collection, products } = detail;
---

<ProductSection
  title={collection.name}
  description={collection.description}
  products={products.slice(0, 4)}
  viewAllHref={`/collections/${collection.slug}`}
/>
