---
import { formatMoney } from "../../lib/money";
import type { CollectionDetail } from "../../api/catalog";

interface Props {
  detail: CollectionDetail;
  featured?: boolean;
}

const { detail, featured = false } = Astro.props;
const { collection, products } = detail;
const previewProducts = products.slice(0, featured ? 4 : 3);
const heroImage =
  previewProducts[0]?.primary_image_gallery_url ??
  previewProducts[0]?.primary_image_card_url ??
  previewProducts[0]?.primary_image_url ??
  null;
---

{
  featured ? (
    <a
      href={`/collections/${collection.slug}`}
      class="group relative flex h-full min-h-96 flex-col overflow-hidden rounded-2xl bg-foreground"
    >
      {/* Full-bleed hero image */}
      <div class="absolute inset-0">
        {heroImage ? (
          <img
            src={heroImage}
            alt={collection.name}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full items-center justify-center bg-muted text-muted-foreground/30">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-16 w-16"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.25"
                d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
              />
            </svg>
          </div>
        )}
        {/* Gradient overlay for text readability */}
        <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent" />
      </div>

      {/* Content pinned to bottom */}
      <div class="relative mt-auto flex flex-col p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-white/60">
          Collection
        </p>
        <h3 class="mt-1.5 font-heading text-2xl font-bold leading-tight text-white sm:text-3xl">
          {collection.name}
        </h3>
        {collection.description && (
          <p class="mt-2 line-clamp-2 max-w-md text-sm leading-relaxed text-white/70">
            {collection.description}
          </p>
        )}
        <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-white transition-all group-hover:gap-2.5">
          Explore
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </span>
      </div>
    </a>
  ) : (
    <a
      href={`/collections/${collection.slug}`}
      class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-background transition-all duration-200 hover:-translate-y-0.5 hover:border-border/80 hover:bg-muted/30 hover:shadow-md"
    >
      <div class="flex flex-1 flex-col p-4 sm:p-5">
        <h3 class="font-heading text-base font-bold text-foreground sm:text-lg">
          {collection.name}
        </h3>
        {collection.description && (
          <p class="mt-1 line-clamp-2 text-xs leading-5 text-muted-foreground sm:text-sm">
            {collection.description}
          </p>
        )}

        {previewProducts.length > 0 && (
          <div class="mt-auto pt-4">
            <div class="grid grid-cols-3 gap-2 sm:gap-2.5">
              {previewProducts.map((product) => {
                const previewImage =
                  product.primary_image_thumb_url ??
                  product.primary_image_card_url ??
                  product.primary_image_url;

                return (
                  <div class="min-w-0">
                    <div class="aspect-square overflow-hidden rounded-lg bg-muted">
                      {previewImage ? (
                        <img
                          src={previewImage}
                          alt={product.name}
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex h-full items-center justify-center text-muted-foreground/30">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="1.25"
                              d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159"
                            />
                          </svg>
                        </div>
                      )}
                    </div>
                    <p class="mt-1 truncate text-[11px] font-medium text-muted-foreground">
                      {formatMoney(product.base_price)}
                    </p>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>

      <div class="border-t border-border px-4 py-3 sm:px-5">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary transition-all group-hover:gap-2">
          Explore
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </span>
      </div>
    </a>
  )
}
