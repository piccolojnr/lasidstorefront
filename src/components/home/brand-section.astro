---
import type { BrandSummary } from "../../api/catalog";

interface Props {
  title?: string;
  brands?: BrandSummary[];
  viewAllHref?: string;
}

const {
  title = "Top Brands",
  brands = [],
  viewAllHref = "/brands",
} = Astro.props;

const visibleBrands = brands.slice(0, 6);
---

{
  visibleBrands.length > 0 && (
    <section class="bg-card/50 py-14 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {/* Section header */}
        <div class="mb-10 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-primary">
              Trusted names
            </p>
            <h2 class="mt-1.5 font-heading text-2xl font-bold text-foreground sm:text-3xl">
              {title}
            </h2>
          </div>
          <a
            href={viewAllHref}
            class="group shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            View All
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        {/* Brand grid */}
        <div class="overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] md:overflow-visible md:pb-0">
          <div class="flex min-w-max gap-3 md:grid md:min-w-0 md:grid-cols-3 md:gap-4 lg:grid-cols-6">
            {visibleBrands.map((brand) => (
              <a
                href={`/brands/${brand.slug}`}
                class="group flex w-36 shrink-0 flex-col items-center rounded-2xl border border-border bg-background px-4 py-6 text-center transition-all duration-200 hover:-translate-y-1 hover:border-primary/20 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30 md:w-auto"
              >
                <div class="flex size-14 items-center justify-center rounded-full bg-card sm:size-16">
                  {brand.image_url ? (
                    <img
                      src={brand.image_url}
                      alt={brand.name}
                      class="max-h-8 w-auto object-contain transition-transform duration-200 group-hover:scale-110 sm:max-h-10"
                      loading="lazy"
                    />
                  ) : (
                    <span class="font-heading text-xl font-bold text-foreground sm:text-2xl">
                      {brand.name.slice(0, 1)}
                    </span>
                  )}
                </div>
                <p class="mt-3 line-clamp-2 text-sm font-semibold text-foreground">
                  {brand.name}
                </p>
                {typeof brand.products_count === "number" && (
                  <p class="mt-1 text-xs text-muted-foreground">
                    {brand.products_count}{" "}
                    {brand.products_count === 1 ? "product" : "products"}
                  </p>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
