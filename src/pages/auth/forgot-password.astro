---
import Layout from "../../layouts/layout.astro";
import ForgotPasswordForm from "../../components/auth/forgot-password-form";
---

<Layout title="Forgot password">
  <div class="flex min-h-[80dvh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <a href="/" class="font-heading text-2xl font-bold tracking-tight text-foreground">Backthred</a>
        <p class="mt-2 text-sm text-muted-foreground">Reset your password</p>
      </div>
      <ForgotPasswordForm client:load />
    </div>
  </div>
</Layout>
