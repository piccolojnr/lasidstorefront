---
import Layout from "../../layouts/layout.astro";
import LoginForm from "../../components/auth/login-form";
import { ROUTES } from "../../lib/constants";

const redirectTo =
  Astro.url.searchParams.get("redirect") ?? ROUTES.accountOrders;
---

<Layout title="Sign in">
  <div class="flex min-h-[80dvh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <a href="/" class="font-heading text-2xl font-bold tracking-tight text-foreground">Lasid</a>
        <p class="mt-2 text-sm text-muted-foreground">Sign in to your account</p>
      </div>
      <LoginForm client:load redirectTo={redirectTo} />
    </div>
  </div>
</Layout>
