---
import Layout from '../../layouts/layout.astro';
import ResetPasswordForm from '../../components/auth/reset-password-form';

const token = Astro.url.searchParams.get('token') ?? '';
const email = Astro.url.searchParams.get('email') ?? '';

// Missing params — redirect to forgot password
if (!token || !email) {
  return Astro.redirect('/auth/forgot-password');
}
---

<Layout title="Reset password">
  <div class="flex min-h-[80dvh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">

      <div class="mb-8 text-center">
        <a href="/" class="text-2xl font-bold tracking-tight">Lasid</a>
        <p class="mt-2 text-sm text-gray-500">Choose a new password</p>
      </div>

      <ResetPasswordForm client:load token={token} email={email} />

    </div>
  </div>
</Layout>
