---
import Layout from "../layouts/layout.astro";
import HeroSection from "../components/home/hero-section.astro";
import CollectionSection from "../components/home/collection-section.astro";
import ProductSection from "../components/home/product-section.astro";
import { catalogApi } from "../api/catalog";

const [featuredResult, categoriesResult, collectionsResult] =
  await Promise.allSettled([
    catalogApi.getProducts({ featured: 1, sort: "latest" }),
    catalogApi.getCategories({ root_only: true }),
    catalogApi.getCollections(),
  ]);

const featured =
  featuredResult.status === "fulfilled" ? featuredResult.value.data : [];
const cats =
  categoriesResult.status === "fulfilled" ? categoriesResult.value : [];
const collections =
  collectionsResult.status === "fulfilled" ? collectionsResult.value : [];
const homepageCollections = collections.slice(0, 3);
const collectionDetailResults = await Promise.allSettled(
  homepageCollections.map((collection) => catalogApi.getCollection(collection.slug)),
);
const collectionDetails = collectionDetailResults
  .filter((result) => result.status === "fulfilled")
  .map((result) => result.value);

const heroSlides = [
  {
    eyebrow: "#Big Fashion Sale",
    title: "Limited Time Offer!",
    description: "Up to 50% OFF on everyday fashion essentials.",
    ctaHref: "/products",
    ctaLabel: "Shop Now",
    imageSrc: "/images/hero-1.jpg",
    imageAlt: "Folded t-shirts and white sneakers on a pure white background",
  },
  {
    eyebrow: "#Denim Picks",
    title: "Everyday denim made simple.",
    description: "Shop jeans and casual staples for clean everyday outfits.",
    ctaHref: "/products?category=jeans",
    ctaLabel: "Shop Denim",
    imageSrc: "/images/hero-2.jpg",
    imageAlt:
      "Folded blue jeans with neutral t-shirts on a pure white background",
  },
  {
    eyebrow: "#Footwear Deals",
    title: "Step out in clean style.",
    description: "Find sneakers and shoes that fit your everyday look.",
    ctaHref: "/products?category=shoes",
    ctaLabel: "Shop Shoes",
    imageSrc: "/images/hero-3.jpg",
    imageAlt:
      "Clean white and neutral sneakers arranged on a pure white background",
  },
  {
    eyebrow: "#Accessories",
    title: "Finish the look.",
    description:
      "Complete your outfit with bags, watches, and simple accessories.",
    ctaHref: "/products?category=accessories",
    ctaLabel: "Shop Accessories",
    imageSrc: "/images/hero-4.jpg",
    imageAlt:
      "Bag, wristwatch, and sunglasses arranged on a pure white background",
  },
  {
    eyebrow: "#Shop The Look",
    title: "Build your full outfit.",
    description:
      "Explore complete casual looks with shirts, jeans, shoes, and accessories.",
    ctaHref: collections[0]
      ? `/collections/${collections[0].slug}`
      : "/collections",
    ctaLabel: "View Collections",
    imageSrc: "/images/hero-5.jpg",
    imageAlt:
      "Complete casual outfit arranged neatly on a pure white background",
  },
];

const heroCategories = cats.slice(0, 8).map((cat) => ({
  name: cat.name,
  href: `/products?category=${cat.slug}`,
}));
---

<Layout
  title="Find what you need"
  description="Everyday goods for everyday Ghanaians. Affordable fashion, lifestyle, books and more."
>
  <HeroSection slides={heroSlides} categories={heroCategories} />

  {
    collectionDetails.map((detail) => (
      <CollectionSection detail={detail} />
    ))
  }

  {
    featured.length > 0 && (
      <ProductSection
        title="Featured Products"
        description="A simple selection of products worth starting with."
        products={featured}
        viewAllHref="/products?featured=1"
      />
    )
  }

  <!-- ── Why Lasid ────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div
      class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border rounded-2xl overflow-hidden border border-border"
    >
      <div class="bg-background p-8 flex flex-col gap-3">
        <div
          class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="font-heading text-foreground font-semibold text-base mb-1">
            Authentic Products
          </p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Every item sourced from verified suppliers and trusted brands across
            Ghana.
          </p>
        </div>
      </div>

      <div class="bg-background p-8 flex flex-col gap-3">
        <div
          class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
            ></path>
          </svg>
        </div>
        <div>
          <p class="font-heading text-foreground font-semibold text-base mb-1">
            Fast Delivery
          </p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Delivering across all 16 regions. Track your order every step of the
            way.
          </p>
        </div>
      </div>

      <div class="bg-background p-8 flex flex-col gap-3">
        <div
          class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="font-heading text-foreground font-semibold text-base mb-1">
            Secure Checkout
          </p>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Pay safely with Paystack. Your payment details are always encrypted.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20">
    <div
      class="rounded-2xl bg-foreground px-8 py-12 sm:px-12 sm:py-14 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8"
    >
      <div>
        <p
          class="text-primary text-xs font-semibold tracking-[0.2em] uppercase mb-3 flex items-center gap-2"
        >
          <span class="block h-px w-5 bg-primary shrink-0"></span>
          Join Lasid
        </p>
        <h2
          class="font-heading text-background font-bold text-2xl sm:text-3xl leading-tight mb-2"
        >
          Start shopping in seconds.
        </h2>
        <p class="text-background/60 text-sm leading-relaxed max-w-sm">
          Save addresses, track orders, and check out faster. Free to join.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a
          href="/auth/login"
          class="bg-primary hover:bg-primary/90 text-primary-foreground font-semibold px-6 py-3 rounded-lg text-sm transition-colors text-center"
        >
          Create Account
        </a>
        <a
          href="/products"
          class="border border-background/20 hover:border-background/40 text-background/80 hover:text-background font-medium px-6 py-3 rounded-lg text-sm transition-colors text-center"
        >
          Browse First
        </a>
      </div>
    </div>
  </section>
</Layout>
