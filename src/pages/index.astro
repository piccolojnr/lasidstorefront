---
import Layout from "../layouts/layout.astro";
import HeroMosaicSection from "../components/home/hero-mosaic-section.astro";
import CategoryTileGrid from "../components/home/category-tile-grid.astro";
import ProductSection from "../components/home/product-section.astro";
import PromoBanner from "../components/home/promo-banner.astro";
import { catalogApi } from "../api/catalog";
import { siteConfig } from "../lib/site-config";

const [latestResult, saleResult, popularResult, categoriesResult] =
  await Promise.allSettled([
    catalogApi.getProducts({ sort: "latest" }),
    catalogApi.getProducts({ on_sale: true, sort: "latest" }),
    catalogApi.getProducts({
      sort: "popular",
      popularity_period: "7d",
    }),
    catalogApi.getCategories({ root_only: false }),
  ]);

const latestProducts =
  latestResult.status === "fulfilled"
    ? latestResult.value.data.slice(0, 8)
    : [];
const saleProducts =
  saleResult.status === "fulfilled" ? saleResult.value.data.slice(0, 8) : [];
const popularProducts =
  popularResult.status === "fulfilled"
    ? popularResult.value.data.slice(0, 8)
    : [];
const categories =
  categoriesResult.status === "fulfilled" ? categoriesResult.value : [];
---

<Layout
  title="Find what you need"
  description="Everyday goods for everyday Ghanaians. Affordable fashion, electronics, home products, beauty and more."
>
  <HeroMosaicSection
    hero={siteConfig.homepage.hero}
    sidePromos={siteConfig.homepage.sidePromos}
  />

  <CategoryTileGrid categories={categories} />

  {
    latestProducts.length > 0 && (
      <ProductSection
        title="New Arrivals"
        description="Freshly stocked this week."
        products={latestProducts}
        viewAllHref="/products?sort=latest"
      />
    )
  }

  {
    saleProducts.length > 0 && (
      <ProductSection
        title="Flash Sales"
        description="Good deals from products currently on sale."
        products={saleProducts}
        viewAllHref="/products?on_sale=true"
      />
    )
  }

  <PromoBanner
    eyebrow={siteConfig.homepage.banner.eyebrow}
    title={siteConfig.homepage.banner.title}
    ctaLabel={siteConfig.homepage.banner.ctaLabel}
    href={siteConfig.homepage.banner.href}
    imageSrc={siteConfig.homepage.banner.imageSrc}
  />

  {
    popularProducts.length > 0 && (
      <ProductSection
        title="Popular This Week"
        description="Fast-moving items across all departments."
        products={popularProducts}
        viewAllHref="/products?sort=popular&popularity_period=7d"
      />
    )
  }
</Layout>
