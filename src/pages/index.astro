---
import Layout from '../layouts/layout.astro';
import ProductGrid from '../components/catalog/product-grid.astro';
import { catalogApi } from '../api/catalog';

const [featuredResult, categoriesResult, collectionsResult] = await Promise.allSettled([
  catalogApi.getProducts({ featured: 1, sort: 'latest' }),
  catalogApi.getCategories({ root_only: true }),
  catalogApi.getCollections(),
]);

const featured = featuredResult.status === 'fulfilled' ? featuredResult.value.data : [];
const cats = categoriesResult.status === 'fulfilled' ? categoriesResult.value : [];
const collections = collectionsResult.status === 'fulfilled' ? collectionsResult.value : [];

// Warm earthy accent pool for category cards
const catColors = [
  { bg: '#D4521A', text: '#FAF7F2' },   // terracotta
  { bg: '#EDE8E0', text: '#1C1410' },   // warm stone
  { bg: '#1C1410', text: '#FAF7F2' },   // deep brown
  { bg: '#F5A623', text: '#1C1410' },   // amber
  { bg: '#3D7A5C', text: '#FAF7F2' },   // earthy green
  { bg: '#926040', text: '#FAF7F2' },   // warm tan
  { bg: '#F5EFE6', text: '#1C1410' },   // cream
  { bg: '#5C3D2A', text: '#FAF7F2' },   // dark brown
];
---

<Layout title="Find what you need" description="Everyday goods for everyday Ghanaians. Affordable fashion, lifestyle, books and more.">

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="bg-background border-b border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-0 items-stretch py-16 lg:py-0">

        <!-- Left: Welcome message -->
        <div class="flex flex-col justify-center lg:py-24 lg:pr-16">
          <span class="inline-flex items-center gap-2.5 text-primary text-xs font-semibold tracking-[0.2em] uppercase mb-6">
            <span class="block h-px w-6 bg-primary shrink-0"></span>
            For everyday Ghana
          </span>
          <h1 class="font-heading text-foreground font-bold leading-[1.08] tracking-tight mb-6" style="font-size: clamp(2.4rem, 5.5vw, 4rem);">
            Find what<br />you need.
          </h1>
          <p class="text-muted-foreground text-base sm:text-lg leading-relaxed max-w-sm mb-10">
            Affordable fashion, lifestyle, books and more. Good prices, trusted sellers, delivered across Ghana.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/products"
              class="bg-primary hover:bg-primary/90 text-primary-foreground font-semibold px-6 py-3 rounded-lg text-sm transition-colors"
            >
              Shop Now
            </a>
            <a
              href="/auth/login"
              class="border border-border hover:border-foreground/40 text-foreground font-medium px-6 py-3 rounded-lg text-sm transition-colors"
            >
              Create Account
            </a>
          </div>
        </div>

        <!-- Right: Category window — warm mosaic of what's available -->
        <div class="hidden lg:grid grid-cols-2 border-l border-border" style="grid-template-rows: repeat(3, 1fr);">
          {cats.slice(0, 6).map((cat, i) => {
            const color = catColors[i % catColors.length]!;
            return (
              <a
                href={`/products?category=${cat.slug}`}
                class="group relative flex flex-col justify-end p-6 border-b border-r border-border overflow-hidden transition-opacity hover:opacity-90"
                style={`background-color: ${color.bg}; color: ${color.text};`}
              >
                <div
                  class="absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity bg-black"
                ></div>
                <p class="text-xs font-bold tracking-[0.15em] uppercase opacity-50 mb-1 relative z-10">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <p class="font-heading font-bold text-base leading-snug relative z-10">
                  {cat.name}
                </p>
              </a>
            );
          })}
          {/* Fill remaining cells if fewer than 6 categories */}
          {cats.length < 6 && Array.from({ length: 6 - cats.length }).map(() => (
            <div class="border-b border-r border-border bg-muted"></div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ── Marquee ticker ───────────────────────────────────────────────────── -->
  <div class="bg-primary overflow-hidden py-3" aria-hidden="true">
    <div class="lasid-ticker flex whitespace-nowrap">
      {[1, 2].map(() => (
        <span class="flex items-center gap-7 pr-7 text-primary-foreground text-xs font-bold tracking-[0.18em] uppercase shrink-0">
          <span>Free Delivery on Orders Over GHS 200</span>
          <span class="opacity-40">·</span>
          <span>Authentic Products</span>
          <span class="opacity-40">·</span>
          <span>Secure Checkout via Paystack</span>
          <span class="opacity-40">·</span>
          <span>Easy Returns</span>
          <span class="opacity-40">·</span>
          <span>Delivering Across All 16 Regions</span>
          <span class="opacity-40">·</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ── Shop by Category ─────────────────────────────────────────────────── -->
  {cats.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">

      <div class="flex items-end justify-between mb-8 gap-4">
        <div>
          <p class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase mb-1.5">Browse</p>
          <h2 class="font-heading text-foreground text-2xl sm:text-3xl font-bold">Shop by Category</h2>
        </div>
        <a href="/products" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors hidden sm:block shrink-0">
          All products →
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {cats.map((cat, i) => {
          const color = catColors[i % catColors.length]!;
          return (
            <a
              href={`/products?category=${cat.slug}`}
              class="group relative flex flex-col justify-between rounded-xl overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
              style={`background-color: ${color.bg}; color: ${color.text}; min-height: 130px; padding: 1.25rem;`}
            >
              <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-[0.06] transition-opacity"></div>
              <span class="text-xs font-bold tracking-widest uppercase opacity-40 relative z-10">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="font-heading font-bold text-base sm:text-lg leading-snug mt-auto relative z-10">
                {cat.name}
              </p>
            </a>
          );
        })}
      </div>

      <div class="sm:hidden mt-5 text-center">
        <a href="/products" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
          All products →
        </a>
      </div>
    </section>
  )}

  <!-- ── Collections ────────────────────────────────────────────────────────── -->
  {collections.length > 0 && (
    <section class="border-y border-border bg-muted py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="flex items-end justify-between mb-8 gap-4">
          <div>
            <p class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase mb-1.5">Curated</p>
            <h2 class="font-heading text-foreground text-2xl sm:text-3xl font-bold">Collections</h2>
          </div>
          <a href="/collections" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors hidden sm:block shrink-0">
            All collections →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {collections.map((col) => (
            <a
              href={`/collections/${col.slug}`}
              class="group relative flex flex-col justify-between rounded-2xl border border-border bg-background overflow-hidden p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:border-foreground/20"
            >
              <div>
                <p class="font-heading font-bold text-lg text-foreground leading-snug group-hover:text-primary transition-colors">
                  {col.name}
                </p>
                {col.description && (
                  <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2">
                    {col.description}
                  </p>
                )}
              </div>
              <div class="mt-5 flex items-center justify-between">
                <span class="text-xs font-semibold text-muted-foreground">
                  {col.products_count} {col.products_count === 1 ? 'product' : 'products'}
                </span>
                <span class="text-sm font-medium text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                  Browse →
                </span>
              </div>
            </a>
          ))}
        </div>

        <div class="sm:hidden mt-5 text-center">
          <a href="/collections" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
            All collections →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Featured Products ─────────────────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="bg-muted border-y border-border py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-8 gap-4">
          <div>
            <p class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase mb-1.5">Handpicked</p>
            <h2 class="font-heading text-foreground text-2xl sm:text-3xl font-bold">Featured Products</h2>
          </div>
          <a href="/products?featured=1" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors hidden sm:block shrink-0">
            View all →
          </a>
        </div>

        <ProductGrid products={featured} />

        <div class="sm:hidden mt-5 text-center">
          <a href="/products?featured=1" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
            View all →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── Why Lasid ────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-border rounded-2xl overflow-hidden border border-border">

      <div class="bg-background p-8 flex flex-col gap-3">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div>
          <p class="font-heading text-foreground font-semibold text-base mb-1">Authentic Products</p>
          <p class="text-muted-foreground text-sm leading-relaxed">Every item sourced from verified suppliers and trusted brands across Ghana.</p>
        </div>
      </div>

      <div class="bg-background p-8 flex flex-col gap-3">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
          </svg>
        </div>
        <div>
          <p class="font-heading text-foreground font-semibold text-base mb-1">Fast Delivery</p>
          <p class="text-muted-foreground text-sm leading-relaxed">Delivering across all 16 regions. Track your order every step of the way.</p>
        </div>
      </div>

      <div class="bg-background p-8 flex flex-col gap-3">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
        </div>
        <div>
          <p class="font-heading text-foreground font-semibold text-base mb-1">Secure Checkout</p>
          <p class="text-muted-foreground text-sm leading-relaxed">Pay safely with Paystack. Your payment details are always encrypted.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20">
    <div class="rounded-2xl bg-foreground px-8 py-12 sm:px-12 sm:py-14 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">
      <div>
        <p class="text-primary text-xs font-semibold tracking-[0.2em] uppercase mb-3 flex items-center gap-2">
          <span class="block h-px w-5 bg-primary shrink-0"></span>
          Join Lasid
        </p>
        <h2 class="font-heading text-background font-bold text-2xl sm:text-3xl leading-tight mb-2">
          Start shopping in seconds.
        </h2>
        <p class="text-background/60 text-sm leading-relaxed max-w-sm">
          Save addresses, track orders, and check out faster. Free to join.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a
          href="/auth/login"
          class="bg-primary hover:bg-primary/90 text-primary-foreground font-semibold px-6 py-3 rounded-lg text-sm transition-colors text-center"
        >
          Create Account
        </a>
        <a
          href="/products"
          class="border border-background/20 hover:border-background/40 text-background/80 hover:text-background font-medium px-6 py-3 rounded-lg text-sm transition-colors text-center"
        >
          Browse First
        </a>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
  @keyframes lasid-ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .lasid-ticker {
    animation: lasid-ticker 36s linear infinite;
  }
  .lasid-ticker:hover {
    animation-play-state: paused;
  }
</style>
