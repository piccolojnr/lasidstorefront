---
import Layout from "../layouts/layout.astro";
import { siteConfig } from "../lib/site-config";

export const prerender = true;
---

<Layout
  title="Contact Us"
  description="Get in touch with the Backthred customer support team. We're available Monday to Saturday, 8am–8pm."
>
  <div class="mx-auto max-w-360 px-4 py-16 sm:px-6 lg:px-8">
    <!-- Page header -->
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Contact Us
      </h1>
      <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
        We're here to help. Reach out through any of the channels below and
        we'll get back to you as soon as possible.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-8 md:grid-cols-2">
      <!-- Contact details -->
      <div class="flex flex-col gap-6">
        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">WhatsApp</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Fastest way to reach us — typical reply within minutes.
          </p>
          <a
            href={siteConfig.contact.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center rounded-lg bg-success px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-success/90"
          >
            {siteConfig.contact.whatsappLabel}
          </a>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">Phone</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Call us during business hours.
          </p>
          <a
            href={`tel:${siteConfig.contact.phone}`}
            class="mt-3 block text-base font-medium text-primary transition-colors hover:text-primary/80"
          >
            {siteConfig.contact.phone}
          </a>
          <p class="mt-1 text-xs text-muted-foreground">
            {siteConfig.contact.supportHours}
          </p>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">Email</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            For non-urgent enquiries and order issues.
          </p>
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="mt-3 block text-base font-medium text-primary transition-colors hover:text-primary/80"
          >
            {siteConfig.contact.email}
          </a>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">Location</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            {siteConfig.contact.location}
          </p>
        </div>
      </div>

      <!-- FAQ shortcut + hours -->
      <div class="flex flex-col gap-6">
        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">Business Hours</h2>
          <ul class="mt-4 flex flex-col gap-2 text-sm">
            {
              [
                { day: "Monday – Friday", hours: "8:00 AM – 8:00 PM" },
                { day: "Saturday", hours: "8:00 AM – 8:00 PM" },
                { day: "Sunday", hours: "Closed" },
              ].map((row) => (
                <li class="flex items-center justify-between border-b border-border pb-2 last:border-0 last:pb-0">
                  <span class="text-muted-foreground">{row.day}</span>
                  <span
                    class={
                      row.hours === "Closed"
                        ? "text-destructive font-medium"
                        : "font-medium text-foreground"
                    }
                  >
                    {row.hours}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">Common Questions</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Before reaching out, check our FAQs — you might find your answer
            there instantly.
          </p>
          <a
            href="/faqs"
            class="mt-4 inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
          >
            View FAQs
          </a>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h2 class="font-semibold text-foreground">Track Your Order</h2>
          <p class="mt-2 text-sm text-muted-foreground">
            Already placed an order? Track its status in your account.
          </p>
          <a
            href="/account/orders"
            class="mt-4 inline-flex items-center rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
          >
            Track Order
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
