---
import Layout from '../../layouts/layout.astro';
import { catalogApi } from '../../api/catalog';

const collectionsResult = await catalogApi.getCollections().catch(() => []);
const collections = Array.isArray(collectionsResult) ? collectionsResult : [];
---

<Layout title="Collections" description="Curated product collections handpicked for you.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 lg:py-14">

    <!-- Heading -->
    <div class="mb-10">
      <p class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase mb-2">Curated</p>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-foreground">Collections</h1>
      <p class="mt-3 text-base text-muted-foreground max-w-lg leading-relaxed">
        Handpicked selections across every category. Each collection is curated to make it easier to find exactly what you're looking for.
      </p>
    </div>

    {collections.length === 0 ? (
      <div class="flex flex-col items-center gap-4 py-24 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-muted-foreground/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
        </svg>
        <div>
          <p class="font-heading text-foreground font-semibold">No collections yet</p>
          <p class="mt-1 text-sm text-muted-foreground">Check back soon — curated picks are on the way.</p>
        </div>
        <a href="/products" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors">
          Browse all products →
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {collections.map((col) => (
          <a
            href={`/collections/${col.slug}`}
            class="group flex flex-col justify-between rounded-2xl border border-border bg-card p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:border-foreground/20"
          >
            <div>
              <p class="font-heading font-bold text-xl text-foreground leading-snug group-hover:text-primary transition-colors">
                {col.name}
              </p>
              {col.description && (
                <p class="mt-2.5 text-sm text-muted-foreground leading-relaxed line-clamp-3">
                  {col.description}
                </p>
              )}
            </div>
            <div class="mt-6 flex items-center justify-between">
              <span class="text-xs font-semibold text-muted-foreground">
                {col.products_count} {col.products_count === 1 ? 'product' : 'products'}
              </span>
              <span class="text-sm font-semibold text-primary opacity-0 group-hover:opacity-100 transition-opacity">
                Browse →
              </span>
            </div>
          </a>
        ))}
      </div>
    )}

  </div>
</Layout>
