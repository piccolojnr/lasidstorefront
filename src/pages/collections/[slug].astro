---
import Layout from '../../layouts/layout.astro';
import ProductCard from '../../components/catalog/product-card.astro';
import { catalogApi } from '../../api/catalog';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/collections');

const currentPage = Astro.url.searchParams.has('page')
  ? Number(Astro.url.searchParams.get('page'))
  : 1;

let detail;
try {
  detail = await catalogApi.getCollection(slug, currentPage);
} catch {
  return Astro.redirect('/collections');
}

const { collection, products, products_meta: meta } = detail;
const totalPages = meta.last_page;
const page       = meta.current_page;

function pageUrl(p: number): string {
  return p > 1 ? `/collections/${slug}?page=${p}` : `/collections/${slug}`;
}

const visiblePages = Array.from({ length: totalPages }, (_, i) => i + 1).filter(
  (p) => p === 1 || p === totalPages || Math.abs(p - page) <= 1,
);
const paginationItems: (number | '...')[] = visiblePages.reduce(
  (acc, p, i, arr) => {
    if (i > 0 && p - arr[i - 1]! > 1) acc.push('...');
    acc.push(p);
    return acc;
  },
  [] as (number | '...')[]
);
---

<Layout title={collection.name} description={collection.description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 lg:py-14">

    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-muted-foreground">
      <a href="/collections" class="hover:text-foreground transition-colors">Collections</a>
      <span>/</span>
      <span class="text-foreground">{collection.name}</span>
    </nav>

    <!-- Heading -->
    <div class="mb-10">
      <p class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase mb-2">Collection</p>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-foreground">{collection.name}</h1>
      {collection.description && (
        <p class="mt-3 text-base text-muted-foreground max-w-lg leading-relaxed">
          {collection.description}
        </p>
      )}
      {meta.total > 0 && (
        <p class="mt-2 text-sm text-muted-foreground">
          {meta.total} {meta.total === 1 ? 'product' : 'products'}
        </p>
      )}
    </div>

    <!-- Products -->
    {products.length === 0 ? (
      <div class="flex flex-col items-center gap-4 py-24 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-muted-foreground/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <div>
          <p class="font-heading text-foreground font-semibold">No products in this collection yet</p>
          <p class="mt-1 text-sm text-muted-foreground">Check back soon.</p>
        </div>
        <a href="/products" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors">
          Browse all products →
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 xl:grid-cols-4">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="mt-10 flex items-center justify-center gap-1.5" aria-label="Pagination">
        {page > 1 && (
          <a
            href={pageUrl(page - 1)}
            class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
          >
            ← Previous
          </a>
        )}
        {paginationItems.map((item) =>
          item === '...' ? (
            <span class="px-1 text-sm text-muted-foreground">…</span>
          ) : (
            <a
              href={pageUrl(item)}
              class:list={[
                'flex h-9 w-9 items-center justify-center rounded-lg border text-sm font-medium transition-colors',
                item === page
                  ? 'border-primary bg-primary text-primary-foreground'
                  : 'border-border text-muted-foreground hover:border-foreground/30 hover:text-foreground',
              ]}
            >
              {item}
            </a>
          )
        )}
        {page < totalPages && (
          <a
            href={pageUrl(page + 1)}
            class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
          >
            Next →
          </a>
        )}
      </nav>
    )}

  </div>
</Layout>
