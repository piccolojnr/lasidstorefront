---
import Layout from '../../layouts/layout.astro';
import { createServerClient } from '../../api/client';
import { ApiError } from '../../api/client';
import { formatMoney } from '../../lib/money';
import type { Order } from '../../api/checkout';

// Paystack redirects back with ?reference=PSK-REF-xxx
// We find the matching order by polling the orders list.
// If no reference, show a generic confirmation.

const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const api = createServerClient(cookieHeader);

let order: Order | null = null;

try {
  const { data } = await api.paginated<Order>('/orders');
  // Most recent order is first
  order = data[0] ?? null;
} catch (err) {
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect('/auth/login');
  }
}
---

<Layout title="Order confirmed">
  <div class="mx-auto max-w-lg px-4 py-16 sm:px-6">
    <div class="flex flex-col items-center gap-6 text-center">

      <!-- Success icon -->
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      </div>

      <div>
        <h1 class="text-2xl font-bold text-gray-900">Order confirmed!</h1>
        {order ? (
          <p class="mt-2 text-sm text-gray-500">
            Order <span class="font-medium text-gray-700">{order.order_number}</span> is being processed.
          </p>
        ) : (
          <p class="mt-2 text-sm text-gray-500">Your payment was received and your order is being processed.</p>
        )}
      </div>

      {order && (
        <div class="w-full rounded-xl border border-gray-100 p-5 text-left">
          <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-gray-400">Summary</p>
          <div class="flex flex-col gap-2 text-sm">
            {order.shipping_address && (
              <div class="flex justify-between">
                <span class="text-gray-500">Delivering to</span>
                <span class="font-medium text-gray-900 text-right max-w-[60%]">
                  {order.shipping_address.name}
                </span>
              </div>
            )}
            {order.shipping_method_name && (
              <div class="flex justify-between">
                <span class="text-gray-500">Shipping</span>
                <span class="text-gray-900">{order.shipping_method_name}</span>
              </div>
            )}
            <hr class="border-gray-100" />
            <div class="flex justify-between font-semibold">
              <span>Total paid</span>
              <span>{formatMoney(order.total_amount)}</span>
            </div>
          </div>
        </div>
      )}

      <div class="flex gap-3">
        {order && (
          <a
            href={`/account/orders/${order.id}`}
            class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700"
          >
            Track order
          </a>
        )}
        <a
          href="/products"
          class="rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-medium text-gray-600 transition hover:border-gray-400"
        >
          Continue shopping
        </a>
      </div>

    </div>
  </div>
</Layout>
