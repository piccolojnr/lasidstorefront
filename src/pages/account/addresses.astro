---
import AccountLayout from '../../layouts/account-layout.astro';
import AddressList from '../../components/account/address-list';
import { createServerClient, ApiError } from '../../api/client';
import { getAuthTokenFromCookies } from '../../lib/auth-cookie';

const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const authToken = getAuthTokenFromCookies(cookieHeader);
const api = createServerClient(authToken);

try {
  // Auth check — if this throws 401 the redirect fires
  await api.get('/profile');
} catch (err) {
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect('/auth/login?redirect=/account/addresses');
  }
}
---

<AccountLayout title="Addresses" description="Your saved delivery addresses.">
  <AddressList client:load />
</AccountLayout>
