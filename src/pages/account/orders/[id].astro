---
import AccountLayout from '../../../layouts/account-layout.astro';
import { createServerClient, ApiError } from '../../../api/client';
import { formatMoney } from '../../../lib/money';
import type { Order } from '../../../api/checkout';
import type { TimelineEvent } from '../../../api/orders';

const { id } = Astro.params;
if (!id) return Astro.redirect('/account/orders');

const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const api = createServerClient(cookieHeader);

let order: Order | null = null;
let timeline: TimelineEvent[] = [];

try {
  [order, timeline] = await Promise.all([
    api.get<Order>(`/orders/${id}`),
    api.get<TimelineEvent[]>(`/orders/${id}/timeline`),
  ]);
} catch (err) {
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect('/auth/login?redirect=/account/orders');
  }
  if (err instanceof ApiError && (err.status === 404 || err.status === 403)) {
    return Astro.redirect('/account/orders');
  }
}

if (!order) return Astro.redirect('/account/orders');

const statusStyles: Record<string, string> = {
  pending:    'bg-amber-50 text-amber-700',
  processing: 'bg-blue-50 text-blue-700',
  completed:  'bg-green-50 text-green-700',
  cancelled:  'bg-red-50 text-red-600',
};

const paymentStyles: Record<string, string> = {
  pending:  'text-amber-600',
  paid:     'text-green-600',
  failed:   'text-destructive',
  refunded: 'text-muted-foreground',
};

function getOrderItemImage(item: Order['items'][number]): string | null {
  return item.primary_image_thumb_url ?? item.primary_image_url;
}
---

<AccountLayout title={`Order ${order.order_number}`}>
  <div class="flex flex-col gap-8">

    <!-- Header -->
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class:list={[
          'rounded-full px-3 py-1 text-sm font-medium capitalize',
          statusStyles[order.status] ?? 'bg-muted text-muted-foreground',
        ]}>
          {order.status}
        </span>
        <span class:list={[
          'text-sm font-medium capitalize',
          paymentStyles[order.payment_status] ?? 'text-muted-foreground',
        ]}>
          Payment: {order.payment_status}
        </span>
      </div>
      <p class="text-sm text-muted-foreground">
        Placed {new Date(order.placed_at).toLocaleDateString('en-GH', {
          year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit',
        })}
      </p>
    </div>

    <!-- Items -->
    {order.items.length > 0 && (
      <section>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Items</h2>
        <div class="flex flex-col divide-y divide-border rounded-xl border border-border">
          {order.items.map((item) => (
            <div class="flex items-start justify-between gap-4 px-5 py-4">
              <div class="flex items-start gap-4">
                <div class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-muted">
                  {getOrderItemImage(item) ? (
                    <img
                      src={getOrderItemImage(item)}
                      alt={item.product_name_snapshot}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center text-muted-foreground/30">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="flex flex-col gap-0.5 text-sm">
                  <p class="font-medium text-foreground">{item.product_name_snapshot}</p>
                  {item.variant_name_snapshot && (
                    <p class="text-muted-foreground">{item.variant_name_snapshot}</p>
                  )}
                  <p class="text-muted-foreground">Qty: {item.quantity} × {formatMoney(item.unit_price)}</p>
                </div>
              </div>
              <p class="text-sm font-semibold text-foreground shrink-0">
                {formatMoney(item.line_total)}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Totals + Shipping -->
    <div class="grid gap-6 sm:grid-cols-2">
      <section class="rounded-xl border border-border p-5">
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Order total</h2>
        <div class="flex flex-col gap-2 text-sm">
          <div class="flex justify-between text-muted-foreground">
            <span>Subtotal</span><span>{formatMoney(order.subtotal_amount)}</span>
          </div>
          {order.discount_amount > 0 && (
            <div class="flex justify-between text-green-600">
              <span>Discount</span><span>-{formatMoney(order.discount_amount)}</span>
            </div>
          )}
          {order.tax_amount > 0 && (
            <div class="flex justify-between text-muted-foreground">
              <span>Tax</span><span>{formatMoney(order.tax_amount)}</span>
            </div>
          )}
          <div class="flex justify-between text-muted-foreground">
            <span>Shipping</span><span>{formatMoney(order.shipping_amount)}</span>
          </div>
          <hr class="border-border" />
          <div class="flex justify-between font-semibold text-foreground">
            <span>Total</span><span>{formatMoney(order.total_amount)}</span>
          </div>
        </div>
      </section>

      {order.shipping_address && (
        <section class="rounded-xl border border-border p-5">
          <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Delivery address</h2>
          <div class="flex flex-col gap-0.5 text-sm">
            <p class="font-medium text-foreground">{order.shipping_address.name}</p>
            {order.shipping_address.address_line_1 && (
              <p class="text-muted-foreground">{order.shipping_address.address_line_1}</p>
            )}
            {order.shipping_address.city && (
              <p class="text-muted-foreground">{order.shipping_address.city}</p>
            )}
            {order.shipping_method_name && (
              <p class="mt-2 text-xs text-muted-foreground">via {order.shipping_method_name}</p>
            )}
          </div>
        </section>
      )}
    </div>

    <!-- Timeline -->
    {timeline.length > 0 && (
      <section>
        <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Tracking</h2>
        <ol class="relative border-l border-border pl-5">
          {timeline.map((event) => (
            <li class="pb-5">
              <div class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full border-2 border-background bg-foreground" />
              <p class="text-sm font-medium text-foreground">{event.label}</p>
              <p class="text-xs text-muted-foreground">
                {new Date(event.occurred_at).toLocaleString('en-GH', {
                  year: 'numeric', month: 'short', day: 'numeric',
                  hour: '2-digit', minute: '2-digit',
                })}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Notes -->
    {order.notes && (
      <section>
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Order notes</h2>
        <p class="text-sm text-muted-foreground">{order.notes}</p>
      </section>
    )}

    <a href="/account/orders" class="self-start text-sm text-muted-foreground hover:text-foreground transition-colors">
      ← Back to orders
    </a>

  </div>
</AccountLayout>
