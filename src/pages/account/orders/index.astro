---
import AccountLayout from '../../../layouts/account-layout.astro';
import { createServerClient, ApiError } from '../../../api/client';
import { getAuthTokenFromCookies } from '../../../lib/auth-cookie';
import { formatMoney } from '../../../lib/money';
import type { Order } from '../../../api/checkout';

const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const authToken = getAuthTokenFromCookies(cookieHeader);
const api = createServerClient(authToken);

let orders: Order[] = [];

try {
  const result = await api.paginated<Order>('/orders');
  orders = result.data;
} catch (err) {
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect('/auth/login?redirect=/account/orders');
  }
}

const statusStyles: Record<string, string> = {
  pending:    'bg-amber-50 text-amber-700',
  processing: 'bg-blue-50 text-blue-700',
  completed:  'bg-green-50 text-green-700',
  cancelled:  'bg-red-50 text-red-600',
};

function itemCount(order: Order): number {
  return order.items.reduce((sum, item) => sum + item.quantity, 0);
}
---

<AccountLayout title="Orders" description="Track, review and manage your purchases.">
  {orders.length === 0 ? (
    <div class="flex flex-col items-center gap-5 rounded-2xl border border-dashed border-border py-20 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 text-muted-foreground/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
      </svg>
      <div>
        <p class="text-base font-semibold text-foreground">No orders yet</p>
        <p class="mt-1 text-sm text-muted-foreground">When you place an order it will show up here.</p>
      </div>
      <a href="/products" class="inline-flex items-center rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
        Start shopping
      </a>
    </div>
  ) : (
    <div class="flex flex-col gap-3">
      {orders.map((order) => {
        const thumbs = order.items
          .map((item) => item.primary_image_thumb_url ?? item.primary_image_url)
          .filter((src): src is string => !!src)
          .slice(0, 4);
        const count = itemCount(order);

        return (
          <a
            href={`/account/orders/${order.id}`}
            class="group flex flex-col gap-4 rounded-xl border border-border bg-background p-4 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-5"
          >
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-sm font-semibold text-foreground">{order.order_number}</p>
                <span class:list={[
                  'rounded-full px-2.5 py-0.5 text-xs font-medium capitalize',
                  statusStyles[order.status] ?? 'bg-muted text-muted-foreground',
                ]}>
                  {order.status}
                </span>
              </div>
              <p class="text-xs text-muted-foreground">
                {new Date(order.placed_at).toLocaleDateString('en-GH', {
                  year: 'numeric', month: 'long', day: 'numeric',
                })}
              </p>
            </div>

            <div class="flex items-center justify-between gap-4">
              <div class="flex min-w-0 items-center gap-3">
                {thumbs.length > 0 && (
                  <div class="flex shrink-0 -space-x-2.5">
                    {thumbs.map((src) => (
                      <img
                        src={src}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        class="h-11 w-11 rounded-lg border-2 border-background object-cover shadow-sm"
                      />
                    ))}
                  </div>
                )}
                <p class="truncate text-xs text-muted-foreground">
                  {count} {count === 1 ? 'item' : 'items'}
                </p>
              </div>
              <div class="flex shrink-0 items-center gap-3">
                <span class="text-sm font-bold text-foreground">{formatMoney(order.total_amount)}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground/50 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  )}
</AccountLayout>
