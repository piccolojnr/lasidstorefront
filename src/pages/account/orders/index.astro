---
import AccountLayout from '../../../layouts/account-layout.astro';
import { createServerClient, ApiError } from '../../../api/client';
import { formatMoney } from '../../../lib/money';
import type { Order } from '../../../api/checkout';

const cookieHeader = Astro.request.headers.get('cookie') ?? '';
const api = createServerClient(cookieHeader);

let orders: Order[] = [];

try {
  const result = await api.paginated<Order>('/orders');
  orders = result.data;
} catch (err) {
  if (err instanceof ApiError && err.status === 401) {
    return Astro.redirect('/auth/login?redirect=/account/orders');
  }
}

const statusStyles: Record<string, string> = {
  pending:    'bg-amber-50 text-amber-700',
  processing: 'bg-blue-50 text-blue-700',
  completed:  'bg-green-50 text-green-700',
  cancelled:  'bg-red-50 text-red-600',
};
---

<AccountLayout title="Orders">
  {orders.length === 0 ? (
    <div class="py-16 text-center">
      <p class="text-muted-foreground text-base">No orders yet.</p>
      <a href="/products" class="mt-3 inline-block text-sm text-primary hover:text-primary/80 underline underline-offset-2 transition-colors">
        Start shopping
      </a>
    </div>
  ) : (
    <div class="flex flex-col divide-y divide-border">
      {orders.map((order) => (
        <a
          href={`/account/orders/${order.id}`}
          class="flex flex-col gap-3 py-5 transition-colors hover:bg-muted/50 sm:flex-row sm:items-center sm:justify-between -mx-4 px-4 rounded-xl"
        >
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <p class="text-sm font-semibold text-foreground">{order.order_number}</p>
              <span class:list={[
                'rounded-full px-2.5 py-0.5 text-xs font-medium capitalize',
                statusStyles[order.status] ?? 'bg-muted text-muted-foreground',
              ]}>
                {order.status}
              </span>
            </div>
            <p class="text-xs text-muted-foreground">
              {new Date(order.placed_at).toLocaleDateString('en-GH', {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </p>
          </div>
          <div class="flex items-center gap-4 text-sm">
            <span class="font-semibold text-foreground">{formatMoney(order.total_amount)}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  )}
</AccountLayout>
