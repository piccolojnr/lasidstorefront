---
import Layout from '../../layouts/layout.astro';
import AddToCart from '../../components/cart/add-to-cart';
import { catalogApi } from '../../api/catalog';
import { formatMoney } from '../../lib/money';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/products');

let product;
try {
  product = await catalogApi.getProduct(slug);
} catch {
  return Astro.redirect('/products');
}

const primaryImage = product.images.find((img) => img.is_primary) ?? product.images[0];

const hasDiscount =
  product.compare_at_price !== null &&
  product.compare_at_price > product.base_price;

const discountPct = hasDiscount
  ? Math.round((1 - product.base_price / product.compare_at_price!) * 100)
  : 0;
---

<Layout title={product.name} description={product.short_description ?? undefined}>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-muted-foreground">
      <a href="/products" class="hover:text-foreground transition-colors">Shop</a>
      {product.category && (
        <>
          <span>/</span>
          <a href={`/products?category=${product.category.slug}`} class="hover:text-foreground transition-colors">
            {product.category.name}
          </a>
        </>
      )}
      <span>/</span>
      <span class="text-foreground">{product.name}</span>
    </nav>

    <!-- Main product section -->
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Image gallery -->
      <div class="flex flex-col gap-3">
        <div class="aspect-square overflow-hidden rounded-2xl bg-muted">
          {primaryImage ? (
            <img
              src={primaryImage.url}
              alt={product.name}
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full items-center justify-center text-muted-foreground/30">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
            </div>
          )}
        </div>

        <!-- Thumbnails -->
        {product.images.length > 1 && (
          <div class="grid grid-cols-5 gap-2">
            {product.images.map((img) => (
              <div
                class:list={[
                  'aspect-square overflow-hidden rounded-lg border-2',
                  img.is_primary ? 'border-foreground' : 'border-transparent',
                ]}
              >
                <img src={img.url} alt="" class="h-full w-full object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Product info -->
      <div class="flex flex-col gap-5">
        {product.brand && (
          <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
            {product.brand.name}
          </p>
        )}

        <div>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            {product.name}
          </h1>
          {product.short_description && (
            <p class="mt-3 text-base text-muted-foreground leading-relaxed">
              {product.short_description}
            </p>
          )}
        </div>

        <!-- Price -->
        <div class="flex items-baseline gap-3">
          <span class="text-2xl font-bold text-foreground">
            {formatMoney(product.base_price)}
          </span>
          {hasDiscount && (
            <>
              <span class="text-base text-muted-foreground line-through">
                {formatMoney(product.compare_at_price!)}
              </span>
              <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-sm font-semibold text-primary">
                -{discountPct}%
              </span>
            </>
          )}
        </div>

        <hr class="border-border" />

        <!-- Add to cart island -->
        <AddToCart
          client:visible
          productId={product.id}
          variants={product.variants}
        />

        <!-- SKU -->
        <p class="text-xs text-muted-foreground">SKU: {product.sku}</p>

        <!-- Full description -->
        {product.description && (
          <div class="pt-4 border-t border-border">
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-widest text-muted-foreground">
              Description
            </h2>
            <div
              class="prose prose-sm max-w-none text-muted-foreground"
              set:html={product.description}
            />
          </div>
        )}
      </div>
    </div>

    <!-- Related products -->
    {product.related_products.length > 0 && (
      <section class="mt-20">
        <h2 class="font-heading mb-6 text-lg font-semibold text-foreground">You may also like</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4">
          {product.related_products.map((related) => (
            <a
              href={`/products/${related.slug}`}
              class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
            >
              <div class="aspect-square overflow-hidden bg-muted">
                {related.primary_image_url ? (
                  <img
                    src={related.primary_image_url}
                    alt={related.name}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center text-muted-foreground/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-3">
                <p class="line-clamp-2 text-sm font-medium text-foreground">{related.name}</p>
                <p class="mt-1 text-sm font-semibold text-foreground">{formatMoney(related.base_price)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
