---
import Layout from "../../layouts/layout.astro";
import ProductImageGallery from "../../components/catalog/product-image-gallery";
import ProductPurchasePanel from "../../components/catalog/product-purchase-panel";
import ProductCard from "../../components/catalog/product-card.astro";
import { catalogApi } from "../../api/catalog";
import { formatMoney } from "../../lib/money";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/products");

let product;
try {
  product = await catalogApi.getProduct(slug);
} catch {
  return Astro.redirect("/products");
}

const badges = product.badges ?? [];
const isOnSale = badges.some((b) => b.key === "on_sale");
const isNewArrival = badges.some((b) => b.key === "new_arrival");
const visibleBadges = badges.slice(0, 3);

const tags = product.tags ?? [];
const collections = product.collections ?? [];
const hasRelated = product.related_products.length > 0;
---

<Layout
  title={product.name}
  description={product.short_description ?? undefined}
>
  <!-- Extra bottom padding on mobile to clear the sticky bar -->
  <div class="mx-auto max-w-360 px-4 pb-24 pt-6 sm:px-6 sm:pb-12 lg:px-8">
    <!-- ── Breadcrumb ───────────────────────────────────────────────── -->
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex items-center gap-1.5 text-sm text-muted-foreground"
    >
      <a
        href="/products"
        class="shrink-0 transition-colors hover:text-foreground"
      >
        Shop
      </a>
      {
        product.category && (
          <>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"
              />
            </svg>
            <a
              href={`/products?category=${product.category.slug}`}
              class="shrink-0 transition-colors hover:text-foreground"
            >
              {product.category.name}
            </a>
          </>
        )
      }
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-3.5 w-3.5 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
      </svg>
      <span class="truncate text-foreground font-medium">{product.name}</span>
    </nav>

    <!-- ── Main grid ────────────────────────────────────────────────── -->
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]"
    >
      <!-- Left: image gallery island -->
      <ProductImageGallery
        client:load
        images={product.images}
        productName={product.name}
      />

      <!-- Right: product info -->
      <div class="flex flex-col gap-5">
        <!-- Brand / category meta -->
        <div class="flex items-center gap-2 flex-wrap">
          {
            product.brand && (
              <a
                href={`/brands/${product.brand.slug}`}
                class="text-xs font-semibold uppercase tracking-widest text-primary transition-colors hover:text-primary/80"
              >
                {product.brand.name}
              </a>
            )
          }
          {
            product.brand && product.category && (
              <span class="text-muted-foreground/40 text-xs">·</span>
            )
          }
          {
            product.category && (
              <a
                href={`/products?category=${product.category.slug}`}
                class="text-xs text-muted-foreground transition-colors hover:text-foreground"
              >
                {product.category.name}
              </a>
            )
          }
        </div>

        <!-- Title -->
        <div>
          <h1
            class="font-heading text-2xl font-bold leading-tight tracking-tight text-foreground sm:text-3xl"
          >
            {product.name}
          </h1>
          {
            product.short_description && (
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
                {product.short_description}
              </p>
            )
          }
        </div>

        <!-- Badges -->
        {
          visibleBadges.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {visibleBadges.map((badge) => (
                <span
                  class:list={[
                    "rounded-full px-3 py-1 text-xs font-semibold",
                    badge.key === "on_sale"
                      ? "bg-destructive text-white"
                      : badge.key === "new_arrival"
                        ? "bg-accent text-accent-foreground"
                        : "bg-muted text-muted-foreground",
                  ]}
                >
                  {badge.key === "new_arrival" ? "New arrival" : badge.label}
                </span>
              ))}
            </div>
          )
        }

        {/* SKU shown here only for simple products; variant SKU is shown inside the purchase panel */}
        {!product.has_variants && (
          <p class="text-xs text-muted-foreground">SKU: {product.sku}</p>
        )}

        <!-- Purchase panel island (price + stock + variants + qty + add-to-cart + mobile sticky) -->
        <ProductPurchasePanel
          client:load
          productId={product.id}
          basePrice={product.base_price}
          compareAtPrice={product.compare_at_price}
          stock={product.stock ?? null}
          trackInventory={product.track_inventory}
          allowBackorders={product.allow_backorders}
          hasVariants={product.has_variants}
          optionTypes={product.option_types ?? []}
          variants={product.variants}
        />

        <!-- Trust notes -->
        <div class="flex flex-col gap-2 sm:flex-row sm:gap-5">
          <span
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
              ></path>
            </svg>
            Secure payment
          </span>
          <span
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
              ></path>
            </svg>
            Delivery across Ghana
          </span>
          <span
            class="inline-flex items-center gap-1.5 text-xs text-muted-foreground"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"></path>
            </svg>
            Easy returns
          </span>
        </div>

        <!-- Tags -->
        {
          tags.length > 0 && (
            <div class="pt-1">
              {tags.length <= 5 ? (
                /* Five or fewer — just show them all, no toggle needed */
                <div class="flex flex-wrap gap-1.5">
                  {tags.map((tag) => (
                    <a
                      href={`/products?tag=${tag.slug}`}
                      class="rounded-full border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
                    >
                      {tag.name}
                    </a>
                  ))}
                </div>
              ) : (
                /* More than five — show first 5, collapse the rest */
                <div>
                  <div class="flex flex-wrap gap-1.5">
                    {tags.slice(0, 5).map((tag) => (
                      <a
                        href={`/products?tag=${tag.slug}`}
                        class="rounded-full border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
                      >
                        {tag.name}
                      </a>
                    ))}
                  </div>

                  <details class="group mt-1.5">
                    <summary class="inline-flex cursor-pointer select-none list-none items-center gap-1 text-xs font-medium text-primary hover:text-primary/80 transition-colors [&::-webkit-details-marker]:hidden">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3 w-3 transition-transform duration-200 group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
                      </svg>
                      <span class="group-open:hidden">+{tags.length - 5} more tags</span>
                      <span class="hidden group-open:inline">Show less</span>
                    </summary>
                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                      {tags.slice(5).map((tag) => (
                        <a
                          href={`/products?tag=${tag.slug}`}
                          class="rounded-full border border-border px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
                        >
                          {tag.name}
                        </a>
                      ))}
                    </div>
                  </details>
                </div>
              )}
            </div>
          )
        }

        <!-- Collections membership -->
        {
          collections.length > 0 && (
            <div class="flex flex-col gap-1.5 pt-1">
              {collections.map((col) => (
                <a
                  href={`/collections/${col.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.75"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"
                    />
                  </svg>
                  Part of{" "}
                  <span class="font-medium text-foreground">{col.name}</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <!-- ── Description ──────────────────────────────────────────────── -->
    {
      product.description && (
        <section class="mt-16 border-t border-border pt-12">
          <h2 class="font-heading mb-5 text-xl font-bold text-foreground">
            About this product
          </h2>
          <div
            class="prose prose-sm max-w-3xl text-muted-foreground [&_h2]:font-heading [&_h2]:text-foreground [&_h3]:font-heading [&_h3]:text-foreground [&_a]:text-primary [&_a]:no-underline hover:[&_a]:underline"
            set:html={product.description}
          />
        </section>
      )
    }

    <!-- ── Related products ─────────────────────────────────────────── -->
    {
      hasRelated && (
        <section class="mt-16 border-t border-border pt-12">
          <h2 class="font-heading mb-8 text-xl font-bold text-foreground">
            You may also like
          </h2>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4">
            {product.related_products.map((related) => (
              <ProductCard product={related} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
