---
import Layout from '../../layouts/layout.astro';
import AddToCart from '../../components/cart/add-to-cart';
import { catalogApi } from '../../api/catalog';
import { formatMoney } from '../../lib/money';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/products');

let product;
try {
  product = await catalogApi.getProduct(slug);
} catch {
  return Astro.redirect('/products');
}

const primaryImage = product.images.find((img) => img.is_primary) ?? product.images[0];

const hasDiscount =
  product.compare_at_price !== null &&
  product.compare_at_price > product.base_price;

const discountPct = hasDiscount
  ? Math.round((1 - product.base_price / product.compare_at_price!) * 100)
  : 0;
---

<Layout title={product.name} description={product.short_description ?? undefined}>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">

    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center gap-2 text-sm text-gray-400">
      <a href="/products" class="hover:text-gray-600 transition-colors">Shop</a>
      {product.category && (
        <>
          <span>/</span>
          <a href={`/products?category=${product.category.slug}`} class="hover:text-gray-600 transition-colors">
            {product.category.name}
          </a>
        </>
      )}
      <span>/</span>
      <span class="text-gray-700">{product.name}</span>
    </nav>

    <!-- Main product section -->
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Image gallery -->
      <div class="flex flex-col gap-3">
        <div class="aspect-square overflow-hidden rounded-2xl bg-gray-50">
          {primaryImage ? (
            <img
              src={primaryImage.url}
              alt={product.name}
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full items-center justify-center text-gray-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
            </div>
          )}
        </div>

        <!-- Thumbnails -->
        {product.images.length > 1 && (
          <div class="grid grid-cols-5 gap-2">
            {product.images.map((img) => (
              <div
                class:list={[
                  'aspect-square overflow-hidden rounded-lg border-2',
                  img.is_primary ? 'border-gray-900' : 'border-transparent',
                ]}
              >
                <img src={img.url} alt="" class="h-full w-full object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Product info -->
      <div class="flex flex-col gap-5">
        {product.brand && (
          <p class="text-sm font-medium uppercase tracking-widest text-gray-400">
            {product.brand.name}
          </p>
        )}

        <div>
          <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
            {product.name}
          </h1>
          {product.short_description && (
            <p class="mt-3 text-base text-gray-500 leading-relaxed">
              {product.short_description}
            </p>
          )}
        </div>

        <!-- Price -->
        <div class="flex items-baseline gap-3">
          <span class="text-2xl font-bold text-gray-900">
            {formatMoney(product.base_price)}
          </span>
          {hasDiscount && (
            <>
              <span class="text-base text-gray-400 line-through">
                {formatMoney(product.compare_at_price!)}
              </span>
              <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-sm font-semibold text-gray-700">
                -{discountPct}%
              </span>
            </>
          )}
        </div>

        <hr class="border-gray-100" />

        <!-- Add to cart island -->
        <AddToCart
          client:visible
          productId={product.id}
          variants={product.variants}
        />

        <!-- SKU -->
        <p class="text-xs text-gray-400">SKU: {product.sku}</p>

        <!-- Full description -->
        {product.description && (
          <div class="pt-4 border-t border-gray-100">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-700">
              Description
            </h2>
            <div
              class="prose prose-sm max-w-none text-gray-600"
              set:html={product.description}
            />
          </div>
        )}
      </div>
    </div>

    <!-- Related products -->
    {product.related_products.length > 0 && (
      <section class="mt-20">
        <h2 class="mb-6 text-lg font-semibold text-gray-900">You may also like</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-4">
          {product.related_products.map((related) => (
            <a
              href={`/products/${related.slug}`}
              class="group flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white transition hover:shadow-md"
            >
              <div class="aspect-square overflow-hidden bg-gray-50">
                {related.primary_image_url ? (
                  <img
                    src={related.primary_image_url}
                    alt={related.name}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center text-gray-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-3">
                <p class="line-clamp-2 text-sm font-medium text-gray-900">{related.name}</p>
                <p class="mt-1 text-sm font-semibold">{formatMoney(related.base_price)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
