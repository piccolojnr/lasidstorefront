---
import Layout from '../../layouts/layout.astro';
import ProductCard from '../../components/catalog/product-card.astro';
import { catalogApi } from '../../api/catalog';
import type { ProductsQuery, Category, BrandSummary } from '../../api/catalog';
import { formatMoney } from '../../lib/money';



const { searchParams } = Astro.url;

// ── Parse current filters from URL ──────────────────────────────────────────
const activeCategory  = searchParams.get('category')  ?? undefined;
const activeBrand     = searchParams.get('brand')      ?? undefined;
const activeSearch    = searchParams.get('search')     ?? undefined;
const activeSort      = (searchParams.get('sort') as ProductsQuery['sort']) ?? 'latest';
const activeFeatured  = searchParams.get('featured') === '1' ? (1 as const) : undefined;
const activeMinPrice  = searchParams.get('min_price') ? Number(searchParams.get('min_price')) : undefined;
const activeMaxPrice  = searchParams.get('max_price') ? Number(searchParams.get('max_price')) : undefined;
const currentPage     = searchParams.has('page') ? Number(searchParams.get('page')) : undefined;

// Price inputs are in GHS (cedis); API expects pesewas — multiply ×100
const query: ProductsQuery = {
  search:    activeSearch,
  category:  activeCategory,
  brand:     activeBrand,
  featured:  activeFeatured,
  sort:      activeSort,
  page:      currentPage,
  min_price: activeMinPrice ? activeMinPrice * 100 : undefined,
  max_price: activeMaxPrice ? activeMaxPrice * 100 : undefined,
};

// ── Data fetching ────────────────────────────────────────────────────────────
const [productsResult, categoriesResult, brandsResult] = await Promise.allSettled([
  catalogApi.getProducts(query),
  catalogApi.getCategories({ root_only: true }),
  catalogApi.getBrands(),
]);

const { data: products, meta } =
  productsResult.status === 'fulfilled'
    ? productsResult.value
    : { data: [], meta: { total: 0, current_page: 1, last_page: 1 } };

const categories: Category[] =
  categoriesResult.status === 'fulfilled' ? categoriesResult.value : [];

const brands: BrandSummary[] =
  brandsResult.status === 'fulfilled' ? brandsResult.value : [];

const totalPages = meta.last_page;
const page       = meta.current_page;

// ── URL builder — preserves all active filters, overrides given keys ─────────
function filterUrl(overrides: Partial<{
  category: string | null;
  brand:    string | null;
  search:   string | null;
  sort:     string | null;
  featured: string | null;
  min_price:string | null;
  max_price:string | null;
  page:     string | null;
}> = {}): string {
  const p = new URLSearchParams();
  const resolved = {
    search:    activeSearch,
    category:  activeCategory,
    brand:     activeBrand,
    sort:      activeSort !== 'latest' ? activeSort : undefined,
    featured:  activeFeatured ? '1' : undefined,
    min_price: activeMinPrice !== undefined ? String(activeMinPrice) : undefined,
    max_price: activeMaxPrice !== undefined ? String(activeMaxPrice) : undefined,
    page:      currentPage && currentPage > 1 ? String(currentPage) : undefined,
    ...Object.fromEntries(
      Object.entries(overrides).map(([k, v]) => [k, v === null ? undefined : v])
    ),
  } as Record<string, string | undefined>;

  Object.entries(resolved).forEach(([k, v]) => {
    if (v !== undefined && v !== '') p.set(k, v);
  });

  const qs = p.toString();
  return `/products${qs ? `?${qs}` : ''}`;
}

function pageUrl(p: number) {
  return filterUrl({ page: p > 1 ? String(p) : null });
}

const visiblePages = Array.from({ length: totalPages }, (_, i) => i + 1).filter(
  (p) => p === 1 || p === totalPages || Math.abs(p - page) <= 1
);

const paginationItems: (number | "...")[] = visiblePages.reduce(
  (acc, p, i, arr) => {
    if (i > 0 && p - arr[i - 1] > 1) acc.push("...");
    acc.push(p);
    return acc;
  },
  [] as (number | "...")[]
);

// ── Category tree helpers ────────────────────────────────────────────────────
function catIsActive(cat: Category): boolean {
  return cat.slug === activeCategory;
}
function catHasActiveChild(cat: Category): boolean {
  return cat.children?.some((c) => c.slug === activeCategory) ?? false;
}

// ── Active filter chips ───────────────────────────────────────────────────────
const chips: { label: string; removeUrl: string }[] = [];

if (activeSearch) {
  chips.push({ label: `"${activeSearch}"`, removeUrl: filterUrl({ search: null, page: null }) });
}
if (activeCategory) {
  // Find label from tree
  let catLabel = activeCategory;
  for (const root of categories) {
    if (root.slug === activeCategory) { catLabel = root.name; break; }
    const child = root.children?.find((c) => c.slug === activeCategory);
    if (child) { catLabel = child.name; break; }
  }
  chips.push({ label: catLabel, removeUrl: filterUrl({ category: null, page: null }) });
}
if (activeBrand) {
  const brandLabel = brands.find((b) => b.slug === activeBrand)?.name ?? activeBrand;
  chips.push({ label: brandLabel, removeUrl: filterUrl({ brand: null, page: null }) });
}
if (activeFeatured) {
  chips.push({ label: 'Featured', removeUrl: filterUrl({ featured: null, page: null }) });
}
if (activeMinPrice !== undefined || activeMaxPrice !== undefined) {
  const lo = activeMinPrice !== undefined ? `GHS ${activeMinPrice}` : '';
  const hi = activeMaxPrice !== undefined ? `GHS ${activeMaxPrice}` : '';
  const label = lo && hi ? `${lo} – ${hi}` : lo ? `From ${lo}` : `Up to ${hi}`;
  chips.push({ label, removeUrl: filterUrl({ min_price: null, max_price: null, page: null }) });
}

const hasActiveFilters = chips.length > 0;

const sortOptions = [
  { value: 'latest',     label: 'Latest' },
  { value: 'price_asc',  label: 'Price: Low to High' },
  { value: 'price_desc', label: 'Price: High to Low' },
];
---

<Layout title="Shop">

  <!-- Mobile filter overlay -->
  <div
    id="filter-overlay"
    class="fixed inset-0 bg-foreground/40 z-40 hidden lg:hidden"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-10">

    <!-- Page heading -->
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h1 class="font-heading text-2xl font-bold text-foreground">Shop</h1>
        {meta.total > 0 && (
          <p class="mt-0.5 text-sm text-muted-foreground">
            {meta.total} product{meta.total !== 1 ? 's' : ''}
          </p>
        )}
      </div>
      <!-- Mobile: filter + sort bar -->
      <div class="flex items-center gap-2 lg:hidden">
        <button
          id="open-filters"
          type="button"
          class="flex items-center gap-1.5 rounded-lg border border-border bg-background px-3.5 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
          </svg>
          Filters
          {hasActiveFilters && (
            <span class="flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-primary-foreground">
              {chips.length}
            </span>
          )}
        </button>
      </div>
    </div>

    <div class="flex gap-8">

      <!-- ── Sidebar ───────────────────────────────────────────────────────── -->
      <aside
        id="filter-sidebar"
        class="fixed inset-y-0 left-0 z-50 flex w-[280px] -translate-x-full flex-col bg-background shadow-xl transition-transform duration-300
               lg:static lg:z-auto lg:w-56 lg:translate-x-0 lg:shadow-none lg:transition-none lg:flex-shrink-0"
      >
        <!-- Mobile sidebar header -->
        <div class="flex items-center justify-between border-b border-border px-5 py-4 lg:hidden">
          <span class="font-heading font-semibold text-foreground">Filters</span>
          <button
            id="close-filters"
            type="button"
            class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
            aria-label="Close filters"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Filter form -->
        <form
          id="filter-form"
          method="get"
          action="/products"
          class="flex flex-1 flex-col gap-6 overflow-y-auto px-5 py-5 lg:px-0"
        >
          <!-- Search -->
          <div>
            <p class="mb-2.5 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Search</p>
            <div class="relative">
              <input
                type="search"
                name="search"
                value={activeSearch ?? ''}
                placeholder="Search products…"
                class="w-full rounded-lg border border-border bg-background py-2 pl-8 pr-3 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring"
              />
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2.5 top-2.5 h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
            </div>
          </div>

          <!-- Categories -->
          {categories.length > 0 && (
            <div>
              <p class="mb-2.5 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Category</p>
              <div class="flex flex-col gap-0.5">

                <!-- All -->
                <a
                  href={filterUrl({ category: null, page: null })}
                  class:list={[
                    'rounded-lg px-2.5 py-1.5 text-sm transition-colors',
                    !activeCategory
                      ? 'bg-primary/10 font-semibold text-primary'
                      : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                  ]}
                >
                  All products
                </a>

                {categories.map((cat) => {
                  const hasChildren = cat.children && cat.children.length > 0;
                  const isOpen = catIsActive(cat) || catHasActiveChild(cat);

                  return hasChildren ? (
                    <details open={isOpen || undefined} class="group">
                      <summary class:list={[
                        'flex cursor-pointer list-none items-center justify-between rounded-lg px-2.5 py-1.5 text-sm transition-colors select-none',
                        catIsActive(cat)
                          ? 'bg-primary/10 font-semibold text-primary'
                          : catHasActiveChild(cat)
                            ? 'font-medium text-foreground'
                            : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                      ]}>
                        <a
                          href={filterUrl({ category: cat.slug, page: null })}
                          class="flex-1"
                          onclick="event.stopPropagation()"
                        >
                          {cat.name}
                        </a>
                        <svg class="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-90 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                        </svg>
                      </summary>
                      <div class="ml-3 mt-0.5 flex flex-col gap-0.5 border-l border-border pl-3">
                        {cat.children.map((child) => (
                          <a
                            href={filterUrl({ category: child.slug, page: null })}
                            class:list={[
                              'rounded-lg px-2.5 py-1.5 text-sm transition-colors',
                              catIsActive(child)
                                ? 'bg-primary/10 font-semibold text-primary'
                                : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                            ]}
                          >
                            {child.name}
                          </a>
                        ))}
                      </div>
                    </details>
                  ) : (
                    <a
                      href={filterUrl({ category: cat.slug, page: null })}
                      class:list={[
                        'rounded-lg px-2.5 py-1.5 text-sm transition-colors',
                        catIsActive(cat)
                          ? 'bg-primary/10 font-semibold text-primary'
                          : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                      ]}
                    >
                      {cat.name}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Brands (shows only when brands endpoint is available) -->
          {brands.length > 0 && (
            <div>
              <p class="mb-2.5 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Brand</p>
              <div class="flex flex-col gap-0.5">
                {brands.map((brand) => (
                  <a
                    href={filterUrl({ brand: activeBrand === brand.slug ? null : brand.slug, page: null })}
                    class:list={[
                      'flex items-center justify-between rounded-lg px-2.5 py-1.5 text-sm transition-colors',
                      activeBrand === brand.slug
                        ? 'bg-primary/10 font-semibold text-primary'
                        : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                    ]}
                  >
                    {brand.name}
                    {activeBrand === brand.slug && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                      </svg>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Price range -->
          <div>
            <p class="mb-2.5 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Price (GHS)</p>
            <div class="flex items-center gap-2">
              <input
                type="number"
                name="min_price"
                value={activeMinPrice ?? ''}
                placeholder="Min"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-2.5 py-1.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring"
              />
              <span class="text-muted-foreground text-xs shrink-0">–</span>
              <input
                type="number"
                name="max_price"
                value={activeMaxPrice ?? ''}
                placeholder="Max"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-2.5 py-1.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring"
              />
            </div>
            <button
              type="submit"
              class="mt-2 w-full rounded-lg border border-border py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
              Apply price
            </button>
          </div>

          <!-- Sort -->
          <div>
            <p class="mb-2.5 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Sort by</p>
            <div class="flex flex-col gap-0.5">
              {sortOptions.map((opt) => (
                <label class:list={[
                  'flex cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-sm transition-colors',
                  activeSort === opt.value
                    ? 'bg-primary/10 font-semibold text-primary'
                    : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                ]}>
                  <input
                    type="radio"
                    name="sort"
                    value={opt.value}
                    checked={activeSort === opt.value}
                    class="sr-only"
                    onchange="this.form.submit()"
                  />
                  <span class:list={[
                    'flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-full border',
                    activeSort === opt.value
                      ? 'border-primary bg-primary'
                      : 'border-muted-foreground/40',
                  ]}>
                    {activeSort === opt.value && (
                      <span class="h-1.5 w-1.5 rounded-full bg-primary-foreground"></span>
                    )}
                  </span>
                  {opt.label}
                </label>
              ))}
            </div>
          </div>

          <!-- Featured toggle -->
          <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-sm transition-colors hover:bg-muted">
            <input
              type="checkbox"
              name="featured"
              value="1"
              checked={!!activeFeatured}
              class="sr-only"
              onchange="this.form.submit()"
            />
            <span class:list={[
              'flex h-4 w-4 shrink-0 items-center justify-center rounded border transition-colors',
              activeFeatured
                ? 'border-primary bg-primary'
                : 'border-muted-foreground/40',
            ]}>
              {activeFeatured && (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 text-primary-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
              )}
            </span>
            <span class:list={[activeFeatured ? 'font-semibold text-primary' : 'text-muted-foreground']}>
              Featured only
            </span>
          </label>

          <!-- Hidden inputs for category and brand (they use links, not form) -->
          {activeCategory && <input type="hidden" name="category" value={activeCategory} />}
          {activeBrand    && <input type="hidden" name="brand"    value={activeBrand} />}

          <!-- Clear all (only when filters are active) -->
          {hasActiveFilters && (
            <a
              href="/products"
              class="mt-auto rounded-lg border border-border px-3 py-2 text-center text-xs font-medium text-muted-foreground transition-colors hover:border-destructive/50 hover:text-destructive"
            >
              Clear all filters
            </a>
          )}

        </form>

        <!-- Mobile: Apply button -->
        <div class="border-t border-border px-5 py-4 lg:hidden">
          <button
            form="filter-form"
            type="submit"
            class="w-full rounded-lg bg-primary py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          >
            Show results
          </button>
        </div>
      </aside>

      <!-- ── Products area ──────────────────────────────────────────────────── -->
      <div class="min-w-0 flex-1">

        <!-- Toolbar: active chips + sort (desktop) -->
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">

          <!-- Active filter chips -->
          <div class="flex flex-wrap gap-1.5">
            {chips.map((chip) => (
              <a
                href={chip.removeUrl}
                class="flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20"
              >
                {chip.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
              </a>
            ))}
          </div>

          <!-- Sort select — desktop only -->
          <div class="hidden lg:flex items-center gap-2 shrink-0">
            <label for="desktop-sort" class="text-xs text-muted-foreground shrink-0">Sort:</label>
            <select
              id="desktop-sort"
              name="sort"
              form="filter-form"
              onchange="document.getElementById('filter-form').submit()"
              class="rounded-lg border border-border bg-background px-3 py-1.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            >
              {sortOptions.map((opt) => (
                <option value={opt.value} selected={activeSort === opt.value}>
                  {opt.label}
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Product grid -->
        {products.length === 0 ? (
          <div class="flex flex-col items-center gap-4 py-24 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-muted-foreground/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
            <div>
              <p class="font-heading text-foreground font-semibold">No products found</p>
              <p class="mt-1 text-sm text-muted-foreground">Try adjusting your filters or search term.</p>
            </div>
            {hasActiveFilters && (
              <a href="/products" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors">
                Clear all filters
              </a>
            )}
          </div>
        ) : (
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 xl:grid-cols-4">
            {products.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        )}

        <!-- Pagination -->
        {totalPages > 1 && (
          <nav class="mt-10 flex items-center justify-center gap-1.5" aria-label="Pagination">
            {page > 1 && (
              <a
                href={pageUrl(page - 1)}
                class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
              >
                ← Previous
              </a>
            )}

            {/* Page number pills */}
{
  paginationItems.map((item, i) =>
    item === "..." ? (
      <span  class="px-1 text-sm text-muted-foreground">…</span>
    ) : (
      <a
        href={pageUrl(item)}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-lg border text-sm font-medium transition-colors",
          item === page
            ? "border-primary bg-primary text-primary-foreground"
            : "border-border text-muted-foreground hover:border-foreground/30 hover:text-foreground",
        ]}
      >
        {item}
      </a>
    )
  )
}
            {page < totalPages && (
              <a
                href={pageUrl(page + 1)}
                class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
              >
                Next →
              </a>
            )}
          </nav>
        )}

      </div>
    </div>
  </div>
</Layout>

<script>
  const overlay  = document.getElementById('filter-overlay');
  const sidebar  = document.getElementById('filter-sidebar');
  const openBtn  = document.getElementById('open-filters');
  const closeBtn = document.getElementById('close-filters');

  function openFilters() {
    overlay?.classList.remove('hidden');
    sidebar?.classList.remove('-translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeFilters() {
    overlay?.classList.add('hidden');
    sidebar?.classList.add('-translate-x-full');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openFilters);
  closeBtn?.addEventListener('click', closeFilters);
  overlay?.addEventListener('click', closeFilters);
</script>
