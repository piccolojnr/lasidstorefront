---
import Layout from "../layouts/layout.astro";
import { siteConfig } from "../lib/site-config";

export const prerender = true;
---

<Layout
  title="About Us"
  description="Learn about Backthred — Ghana's go-to online retailer for clothing, electronics, home goods, beauty products and more."
>
  <div class="mx-auto max-w-360 px-4 py-16 sm:px-6 lg:px-8">
    <!-- Page header -->
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        About Backthred
      </h1>
      <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
        Your go-to online retailer for everyday goods across Ghana.
      </p>
    </div>

    <!-- Story section -->
    <div class="mx-auto mt-16 max-w-3xl">
      <div class="grid gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-xl font-semibold text-foreground">Our Story</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            Backthred was founded with a simple mission: make it easy for
            Ghanaians to shop for quality everyday items online and get them
            delivered fast. We started with fashion and quickly expanded into
            electronics, home goods, beauty products and much more.
          </p>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            We restock weekly so there's always something fresh — whether you're
            looking for the latest sneakers, a new phone, or something for the
            home.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-foreground">Our Mission</h2>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            We believe everyone deserves access to quality products at fair
            prices, delivered reliably and with genuine customer support. Our
            team is based right here in Ghana and we understand what our
            customers need.
          </p>
          <p class="mt-3 text-muted-foreground leading-relaxed">
            From payment to delivery, we've designed the whole experience around
            what works locally — including seamless MoMo payment and next-day
            delivery across Accra, Kumasi and Tema.
          </p>
        </div>
      </div>
    </div>

    <!-- Values -->
    <div class="mt-16">
      <h2 class="text-center text-xl font-semibold text-foreground">
        What We Stand For
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              title: "Quality Products",
              description:
                "Every product on Backthred is carefully selected and quality-checked before listing.",
            },
            {
              title: "Fast Delivery",
              description:
                "Next-day delivery available in Accra, Kumasi and Tema. We know your time matters.",
            },
            {
              title: "Local Payments",
              description:
                "Pay seamlessly with MTN MoMo, Telecel Cash or AirtelTigo Money — no card needed.",
            },
            {
              title: "Easy Returns",
              description:
                "Not satisfied? Return or exchange within 7 days, no complicated process.",
            },
            {
              title: "Honest Pricing",
              description:
                "No hidden fees. The price you see is the price you pay, transparent at every step.",
            },
            {
              title: "Real Support",
              description:
                "Our customer care team is based in Ghana and available Monday to Saturday, 8am–8pm.",
            },
          ].map((value) => (
            <div class="rounded-xl border border-border bg-card p-6">
              <h3 class="font-semibold text-foreground">{value.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Contact CTA -->
    <div
      class="mt-16 rounded-2xl bg-primary/5 border border-primary/10 px-8 py-12 text-center"
    >
      <h2 class="text-xl font-semibold text-foreground">Get in Touch</h2>
      <p class="mt-2 text-muted-foreground">
        Questions? We're always happy to hear from you.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/contact"
          class="rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Contact Us
        </a>
        <a
          href={siteConfig.contact.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</Layout>
