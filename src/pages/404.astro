---
import Layout from "../layouts/layout.astro";
---

<Layout title="Page not found">
  <div class="mx-auto max-w-360 px-4 sm:px-6 lg:px-8">
    <div
      class="flex min-h-[70vh] flex-col items-center justify-center py-24 text-center"
    >
      <!-- Large muted number -->
      <p
        class="font-heading select-none text-[8rem] sm:text-[10rem] font-bold leading-none text-border"
      >
        404
      </p>

      <div class="-mt-4 flex flex-col items-center gap-4">
        <h1 class="font-heading text-2xl font-bold text-foreground sm:text-3xl">
          Page not found.
        </h1>
        <p class="max-w-sm text-muted-foreground text-base leading-relaxed">
          The page you're looking for doesn't exist or may have been moved.
        </p>

        <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          >
            Go home
          </a>
          <a
            href="/products"
            class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground"
          >
            Browse products
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
