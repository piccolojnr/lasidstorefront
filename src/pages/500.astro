---
// Kept standalone — no Layout import — so this page cannot cascade-fail
// if the error came from a shared component or the layout itself.
// Astro passes the unhandled error as a prop in SSR mode.
interface Props {
  error: unknown;
}

const { error } = Astro.props;

const isDev = import.meta.env.DEV;
const errorMessage = isDev && error instanceof Error ? error.message : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Something went wrong — Lasid</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <style>
      /* Inline fallback in case the CSS bundle isn't available */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: "DM Sans Variable", "DM Sans", system-ui, sans-serif;
        background-color: #faf7f2;
        color: #1c1410;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        text-align: center;
        -webkit-font-smoothing: antialiased;
      }
      .num {
        font-family: "Lora Variable", "Lora", Georgia, serif;
        font-size: clamp(6rem, 18vw, 10rem);
        font-weight: 700;
        line-height: 1;
        color: #ede8e0;
        user-select: none;
      }
      .wrap {
        margin-top: -1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }
      h1 {
        font-family: "Lora Variable", "Lora", Georgia, serif;
        font-size: clamp(1.4rem, 4vw, 1.875rem);
        font-weight: 700;
        color: #1c1410;
      }
      p {
        color: #7a6e65;
        max-width: 26rem;
        line-height: 1.65;
        font-size: 1rem;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1rem;
      }
      .btn-primary {
        background: #d4521a;
        color: #faf7f2;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.15s;
      }
      .btn-primary:hover {
        opacity: 0.9;
      }
      .btn-outline {
        border: 1px solid #ddd8cf;
        color: #7a6e65;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition:
          border-color 0.15s,
          color 0.15s;
      }
      .btn-outline:hover {
        border-color: #1c1410;
        color: #1c1410;
      }
      .dev-error {
        margin-top: 2rem;
        max-width: 36rem;
        text-align: left;
        background: #1c1410;
        color: #faf7f2;
        font-family: "ui-monospace", "Menlo", monospace;
        font-size: 0.75rem;
        line-height: 1.6;
        padding: 1rem 1.25rem;
        border-radius: 0.5rem;
        white-space: pre-wrap;
        word-break: break-word;
      }
    </style>
  </head>
  <body>
    <p class="num">500</p>

    <div class="wrap">
      <h1>Something went wrong.</h1>
      <p>
        We ran into a problem on our end. It's not you — we're on it. Try
        refreshing the page, or go back to the shop.
      </p>

      <div class="actions">
        <a href="/" class="btn-primary">Go home</a>
        <a href="/products" class="btn-outline">Browse products</a>
      </div>

      {isDev && errorMessage && <pre class="dev-error">{errorMessage}</pre>}
    </div>
  </body>
</html>
