---
import Layout from "../../layouts/layout.astro";
import { catalogApi } from "../../api/catalog";
import type { Category } from "../../api/catalog";

export const prerender = true;

let categories: Category[] = [];
try {
  categories = await catalogApi.getCategories({ root_only: false });
} catch {
  // render with empty list — no categories to show
}

// Bento slots:
//   [0]        → hero (large)
//   [1], [2]   → medium tiles
//   [3]+       → small grid tiles
const hero = categories[0] ?? null;
const mediums = categories.slice(1, 3);
const smalls = categories.slice(3);
---

<Layout
  title="Browse Categories"
  description="Explore all product categories available on our store — fashion, electronics, home goods, beauty and more."
>
  <div class="mx-auto max-w-360 px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <!-- Page header -->
    <div class="mb-8">
      <nav class="mb-3 flex items-center gap-1.5 text-xs text-muted-foreground">
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
        <span>/</span>
        <span class="text-foreground">Categories</span>
      </nav>
      <h1 class="font-heading text-2xl font-bold text-foreground sm:text-3xl">
        Browse Categories
      </h1>
      <p class="mt-1.5 text-sm text-muted-foreground">
        Shop by category — find exactly what you're looking for.
      </p>
    </div>

    {
      categories.length === 0 ? (
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-20 text-center">
          <p class="text-sm text-muted-foreground">
            No categories available right now.
          </p>
          <a
            href="/products"
            class="mt-4 text-sm font-semibold text-primary transition-colors hover:text-primary/80"
          >
            Browse all products →
          </a>
        </div>
      ) : (
        <div class="space-y-3">
          {/* ── Row 1: hero + two mediums ─────────────────────────────── */}
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {/* Hero tile — 2 cols on mobile, 2 cols on sm+ */}
            {hero &&
              (() => {
                return (
                  <a
                    href={`/products?category=${hero.slug}`}
                    class="group relative col-span-2 min-h-52 overflow-hidden rounded-2xl bg-foreground sm:min-h-64"
                  >
                    {hero.image_url ? (
                      <img
                        src={hero.image_url}
                        alt=""
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                        loading="eager"
                        aria-hidden="true"
                      />
                    ) : null}
                    <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/25 to-transparent" />
                    <div class="relative flex h-full flex-col justify-end p-5 sm:p-6">
                      <span class="mb-2 inline-flex w-fit items-center rounded-full bg-white/15 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-white/90 backdrop-blur-sm">
                        Featured
                      </span>
                      <h2 class="font-heading text-xl font-bold leading-tight text-white sm:text-2xl">
                        {hero.name}
                      </h2>
                      {hero.children && hero.children.length > 0 && (
                        <p class="mt-1 text-sm text-white/70">
                          {hero.children.length}{" "}
                          {hero.children.length === 1
                            ? "subcategory"
                            : "subcategories"}
                        </p>
                      )}
                      <span class="mt-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-white/20 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm transition-colors group-hover:bg-white/30">
                        Shop now
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m8.25 4.5 7.5 7.5-7.5 7.5"
                          />
                        </svg>
                      </span>
                    </div>
                  </a>
                );
              })()}

            {/* Medium tiles — each 1 col on mobile, 1 col on sm+ */}
            {mediums.map((category, i) => {
              return (
                <a
                  href={`/products?category=${category.slug}`}
                  class="group relative min-h-40 overflow-hidden rounded-2xl bg-foreground sm:min-h-64"
                >
                  {category.image_url ? (
                    <img
                      src={category.image_url}
                      alt=""
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                      loading="lazy"
                      aria-hidden="true"
                    />
                  ) : null}
                  <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent" />
                  <div class="relative flex h-full flex-col justify-end p-4 sm:p-5">
                    <h2 class="font-heading text-base font-bold leading-tight text-white sm:text-lg">
                      {category.name}
                    </h2>
                    {category.children && category.children.length > 0 && (
                      <p class="mt-0.5 text-xs text-white/70">
                        {category.children.length}{" "}
                        {category.children.length === 1
                          ? "subcategory"
                          : "subcategories"}
                      </p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>

          {/* ── Row 2+: small tiles ────────────────────────────────────── */}
          {smalls.length > 0 && (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {smalls.map((category, i) => {
                return (
                  <a
                    href={`/products?category=${category.slug}`}
                    class="group relative min-h-36 overflow-hidden rounded-xl bg-foreground"
                  >
                    {category.image_url ? (
                      <img
                        src={category.image_url}
                        alt=""
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                        loading="lazy"
                        aria-hidden="true"
                      />
                    ) : null}
                    <div class="absolute inset-0 bg-linear-to-t from-black/65 via-black/15 to-transparent" />
                    <div class="relative flex h-full flex-col justify-end p-3 sm:p-4">
                      <h2 class="text-sm font-bold leading-tight text-white">
                        {category.name}
                      </h2>
                      {category.children && category.children.length > 0 && (
                        <p class="mt-0.5 text-xs text-white/70">
                          {category.children.length}{" "}
                          {category.children.length === 1
                            ? "subcategory"
                            : "subcategories"}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      )
    }

    <!-- Footer CTA -->
    {
      categories.length > 0 && (
        <div class="mt-10 text-center">
          <p class="text-sm text-muted-foreground">
            Can't find what you're looking for?
          </p>
          <a
            href="/products"
            class="mt-2 inline-block text-sm font-semibold text-primary transition-colors hover:text-primary/80"
          >
            Browse all products →
          </a>
        </div>
      )
    }
  </div>
</Layout>
