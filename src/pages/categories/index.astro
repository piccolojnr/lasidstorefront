---
import Layout from "../../layouts/layout.astro";
import CategoryTile from "../../components/catalog/category-tile.astro";
import { catalogApi } from "../../api/catalog";
import type { Category } from "../../api/catalog";

export const prerender = true;

let categories: Category[] = [];
try {
  categories = await catalogApi.getCategories({ root_only: false });
} catch {
  // render with empty list — no categories to show
}

// Bento slots:
//   [0]        → hero (large)
//   [1], [2]   → medium tiles
//   [3]+       → small grid tiles
const hero = categories[0] ?? null;
const mediums = categories.slice(1, 3);
const smalls = categories.slice(3);
---

<Layout
  title="Browse Categories"
  description="Explore all product categories available on our store — fashion, electronics, home goods, beauty and more."
>
  <div class="mx-auto max-w-360 px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <!-- Page header -->
    <div class="mb-8 sm:mb-10">
      <nav class="mb-3 flex items-center gap-1.5 text-xs text-muted-foreground">
        <a href="/" class="transition-colors hover:text-foreground">Home</a>
        <span>/</span>
        <span class="text-foreground">Categories</span>
      </nav>
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="font-heading text-2xl font-bold text-foreground sm:text-3xl">
            Browse Categories
          </h1>
          <p class="mt-1.5 text-sm text-muted-foreground">
            Shop by category — find exactly what you're looking for.
          </p>
        </div>
        {
          categories.length > 0 && (
            <p class="text-sm tabular-nums text-muted-foreground">
              {categories.length}{" "}
              {categories.length === 1 ? "category" : "categories"}
            </p>
          )
        }
      </div>
    </div>

    {
      categories.length === 0 ? (
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-20 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="mb-4 h-10 w-10 text-muted-foreground/30"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"
            />
          </svg>
          <p class="text-sm text-muted-foreground">
            No categories available right now.
          </p>
          <a
            href="/products"
            class="mt-4 text-sm font-semibold text-primary transition-colors hover:text-primary/80"
          >
            Browse all products →
          </a>
        </div>
      ) : (
        <div class="space-y-3">
          {/* ── Row 1: hero + two mediums ─────────────────────────────── */}
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {hero && <CategoryTile category={hero} size="hero" eager />}
            {mediums.map((category) => (
              <CategoryTile category={category} size="medium" />
            ))}
          </div>

          {/* ── Row 2+: small tiles ────────────────────────────────────── */}
          {smalls.length > 0 && (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {smalls.map((category) => (
                <CategoryTile category={category} size="small" />
              ))}
            </div>
          )}
        </div>
      )
    }

    <!-- Footer CTA -->
    {
      categories.length > 0 && (
        <div class="mt-12 rounded-2xl border border-border bg-card px-6 py-8 text-center">
          <p class="font-heading text-lg font-bold text-foreground">
            Can't find what you're looking for?
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            Browse the full catalogue or use search to find a specific product.
          </p>
          <a
            href="/products"
            class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          >
            Browse all products
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m8.25 4.5 7.5 7.5-7.5 7.5"
              />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</Layout>
