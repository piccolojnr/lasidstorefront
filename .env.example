# Copy to .env and fill in values for local development or Vercel.

# Browser-visible API base.
# Use an absolute URL in production unless you have a same-origin /api/v1 proxy in front of this app.
PUBLIC_API_BASE=https://api.example.com/api/v1

# Server-side API base used by Astro SSR on Vercel.
# This should be an absolute URL to the backend API.
API_BASE=https://api.example.com/api/v1

# Optional: public site URL for canonical links or future metadata usage.
PUBLIC_SITE_URL=https://storefront.example.com
